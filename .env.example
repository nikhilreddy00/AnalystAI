# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from https://e2b.dev/dashboard
E2B_API_KEY=e2b_...

# ── Supabase ───────────────────────────────────────────────────────────────────
# One project provides auth, the database, and file storage.
# Dashboard → Project Settings → API / Database
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — used by the frontend (docker-compose passes it as
# NEXT_PUBLIC_SUPABASE_ANON_KEY). Never put the service_role key here.
SUPABASE_ANON_KEY=eyJ...

# Only needed for legacy (HS256) projects and for running the test suite.
SUPABASE_JWT_SECRET=

# Session-mode pooler (port 5432). Do NOT use the 6543 transaction pooler —
# it does not support the prepared statements SQLAlchemy/asyncpg rely on.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Security ───────────────────────────────────────────────────────────────────
# Required. Encrypts connector secrets (DB strings, API tokens, service-account
# JSON) in the session store. Losing it makes saved connectors unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
# Threads idle (and datasets unused) this many days are deleted from every store: runs, events,
# checkpoints, files, memory. 0 keeps everything forever.
RETENTION_DAYS=0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
