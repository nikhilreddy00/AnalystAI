# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from https://console.groq.com
GROQ_API_KEY=gsk_...

# Get from https://e2b.dev/dashboard
E2B_API_KEY=e2b_...

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=analystai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=analystai

# Set automatically by docker-compose — override only if using an external DB
# DATABASE_URL=postgresql+asyncpg://analystai:change_me@localhost:5432/analystai

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
FRONTEND_URL=http://localhost:3000
