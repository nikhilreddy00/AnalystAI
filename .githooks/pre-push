#!/usr/bin/env bash
# The checks CI runs, before a push (retro 2026-11-03: three CI-only failures in one domain).
# Turn on once per clone: git config core.hooksPath .githooks   Skip in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# a report a test reads must be committed (CI can't see an untracked one)
missing=$(git ls-files --others --exclude-standard evals/reports | while read -r f; do
  grep -rqF "$(basename "$f")" tests/ && echo "$f"; done || true)
if [ -n "$missing" ]; then
  echo "pre-push: commit the reports a test names:"; echo "$missing"; exit 1
fi

uv run ruff check .
uv run pytest -q -n 8 -rf
# CI's zero-suites job ($0, deterministic): Domain 4 went red twice on it unseen; reports go to
# a temp dir (they are no evidence and piled up untracked in evals/reports)
out=$(mktemp -d)
for suite in visualization cleaning ingestion; do
  uv run python -m evals.run "$suite" --k 1 --max-usd 0.01 --fail-under 1.0 --out "$out" > /dev/null
done
uv run python -m evals.run quality --checks-only --k 1 --max-usd 0.01 --fail-under 0.85 --out "$out" > /dev/null
rm -rf "$out"
(cd frontend && npx tsc --noEmit && npm run lint --silent \
  && node --experimental-strip-types --test src/lib/*.test.ts > /dev/null)
# CI's Playwright e2e ($0, mock backend, ~1-2 min): opt in with PREPUSH_E2E=1 git push
if [ "${PREPUSH_E2E:-0}" = 1 ]; then
  uv run python scripts/ui_check/make_fixture.py scripts/ui_check/fixtures --dashboard-only > /dev/null
  (cd frontend && npx playwright test)
fi
echo "pre-push: all checks passed"
