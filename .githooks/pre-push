#!/usr/bin/env bash
# The checks CI runs, before a push (retro 2026-11-03: three CI-only failures in one domain).
# Turn on once per clone: git config core.hooksPath .githooks   Skip in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# the hook checks the working tree and the push sends HEAD: they must be the same files, from
# the first check to the last (retro Domain 5: a file edited while the hook ran was checked,
# never pushed)
tree() { git diff HEAD --name-only; git diff HEAD | shasum; }
start=$(tree)
if [ -n "$(git diff HEAD --name-only)" ]; then
  echo "pre-push: uncommitted changes to tracked files (commit or stash them):"
  git diff HEAD --name-only; exit 1
fi

# a report a test reads must be committed (CI can't see an untracked one)
missing=$(git ls-files --others --exclude-standard evals/reports | while read -r f; do
  grep -rqF "$(basename "$f")" tests/ && echo "$f"; done || true)
if [ -n "$missing" ]; then
  echo "pre-push: commit the reports a test names:"; echo "$missing"; exit 1
fi

uv run ruff check .
uv run lint-imports   # the domain_pack layers + the reference oracle's independence (pyproject)
# the mutation gate (ROADMAP 5.7b-2 step 9): a changed spell / ledger / pack-column / scorer
# function needs its clean gate recorded in docs/mutation/gate.json (mutmut is too slow here)
uv run python scripts/mutation.py --check "$(git merge-base HEAD origin/main)"
# CI (4 shards, ~8 min) is the merge gate; the hook catches the common failures fast: the tests
# this branch touched and the cross-domain contract gates, ~2 min. The whole suite as CI runs
# it: PREPUSH_FULL=1 git push (retro 2026-11-06: 8 min per push, most of it CI's own suite).
if [ "${PREPUSH_FULL:-0}" = 1 ]; then
  uv run pytest -q -n 8 -rf
else
  touched=$(git diff --name-only --diff-filter=d "$(git merge-base HEAD origin/main)" -- 'tests/test_*.py')
  # shellcheck disable=SC2086
  uv run pytest -q -n 8 -rf $touched tests/test_one_definition.py tests/test_second_pack.py \
    tests/test_replay.py tests/test_suite_inputs_unchanged.py tests/test_untrusted_data.py
fi
# CI's zero-suites job ($0, deterministic): Domain 4 went red twice on it unseen; reports go to
# a temp dir (they are no evidence and piled up untracked in evals/reports). The four at once.
out=$(mktemp -d)
pids=()
for suite in visualization cleaning ingestion; do
  uv run python -m evals.run "$suite" --k 1 --max-usd 0.01 --fail-under 1.0 --out "$out" > /dev/null &
  pids+=($!)
done
uv run python -m evals.run quality --checks-only --k 1 --max-usd 0.01 --fail-under 0.85 --out "$out" > /dev/null &
pids+=($!)
for p in "${pids[@]}"; do
  wait "$p" || { echo "pre-push: a \$0 eval suite failed (visualization, cleaning, ingestion or quality --checks-only)"; exit 1; }
done
rm -rf "$out"
(cd frontend && npx tsc --noEmit && npm run lint --silent \
  && node --experimental-strip-types --test src/lib/*.test.ts > /dev/null)
# CI's Playwright e2e ($0, mock backend, ~1-2 min): opt in with PREPUSH_E2E=1 git push
if [ "${PREPUSH_E2E:-0}" = 1 ]; then
  for port in 3100 8100 54321; do   # the live-check stack uses the same ports
    if lsof -nP -iTCP:"$port" -sTCP:LISTEN > /dev/null 2>&1; then
      echo "pre-push: port $port is in use (the live stack? scripts/live_check/down.sh)"; exit 1
    fi
  done
  uv run python scripts/ui_check/make_fixture.py scripts/ui_check/fixtures --dashboard-only > /dev/null
  (cd frontend && npx playwright test)
fi
if [ "$(tree)" != "$start" ]; then
  echo "pre-push: files changed while the checks ran: commit them and push again"; exit 1
fi
echo "pre-push: all checks passed"
