data: {"type": "evidence", "data": [{"id": "source:data", "kind": "source", "claim": "Loaded 3,000 rows \u00d7 19 columns from a CSV file.", "code": "pd.read_csv(<uploaded file>, encoding='utf-8', sep=',')", "result_excerpt": "{\"roles\": {\"id\": [\"Shipment ID\", \"Tracking Number\"], \"category\": [\"Carrier\", \"Mode\", \"Origin City\", \"Dest City\", \"Status\", \"Weight UOM\", \"Currency\", \"Consignee Name\", \"Consignee Phone\"], \"date\": [\"Ship Date\", \"Promised Date\", \"Delivered At\"], \"metric\": [\"Weight\", \"Linehaul\", \"Fuel Surcharge\", \"Accessorials\", \"Total Charge\"]}, \"personal_data\": {\"Tracking Number\": \"identifier\", \"Consignee Name\": \"name\", \"Consignee Phone\": \"phone\"}, \"fingerprint\": \"c60749c9cdbe4cd4\"}", "row_count": 3000, "confidence": "high", "confidence_reason": "Read as-is: no layout guessing was needed.", "assumptions": ["3 columns hold personal data; their values are masked before any model sees them."]}, {"id": "clean:audit", "kind": "cleaning", "claim": "Cleaning: 3000 \u2192 3000 rows, 11 logged changes", "code": "# cleaning rules-v1\ntype_coerce('Weight', unit_converted)\ntype_coerce('Weight UOM', unit_converted)\nsentinel_null('Weight', unknown_unit)\nnormalize('Weight UOM', merge_variants)\nkeep('Promised Date', left_missing)\nkeep('Delivered At', conditional)\nkeep('Weight', left_missing)\nfill_unknown('Weight UOM', unknown_label)\nflag('*', cancel)\nflag('Currency', other_currency)\nflag('transit_days', out_of_range)", "result_excerpt": "{\"rows_before\": 3000, \"rows_after\": 3000, \"decisions\": [[\"Weight\", \"type_coerce\", 837, 0], [\"Weight UOM\", \"type_coerce\", 837, 0], [\"Weight\", \"sentinel_null\", 5, 0], [\"Weight UOM\", \"normalize\", 837, 0], [\"Promised Date\", \"keep\", 0, 0], [\"Delivered At\", \"keep\", 0, 0], [\"Weight\", \"keep\", 0, 0], [\"Weight UOM\", \"fill_unknown\", 5, 0], [\"*\", \"flag\", 62, 0], [\"Currency\", \"flag\", 102, 0], [\"transit_days\", \"flag\", 6, 0]]}", "row_count": 3000, "confidence": "high", "confidence_reason": "rule-based; every change below is logged", "assumptions": ["Weight: 837 weight values in kg (their Weight UOM) converted to lb: \u00d7 2.20462 + 0.", "Weight UOM: 837 rows' unit changed from kg to lb, with their values.", "Weight: 5 weight values in a unit with no conversion to lb ((blank) (5)) read as missing, never averaged with the rest; the rows are kept.", "Weight UOM: Merged spelling variants: 'lb' \u2192 'LB'.", "Promised Date: 15 missing (0.5%), date: left as missing; totals and averages use the 2985 known rows.", "Delivered At: Filled only for rows whose status needs it, so other rows are blank by design; 0.1% of those rows have no value. Kept as it is.", "Weight: 5 missing (0.2%), number: left as missing; totals and averages use the 2995 known rows.", "Weight UOM: 5 missing labels grouped as 'Unknown' (not guessed).", "*: 62 cancelled shipments, lines or appointments: left out of every count and rate; kept in the data.", "Currency: 102 rows in other currencies than USD; kept, left out of money totals.", "transit_days: 6 values outside the valid range (ge 0); kept, check them."]}, {"id": "seg:Carrier/Shipment ID:ratio:on_time_delivery", "kind": "segment", "claim": "on_time_delivery (from Shipment ID) by Carrier (5 groups)", "code": "try:\n    sale_mask = (df['row_kind'] == 'sale') & (df['Currency'] == 'USD')\n    df_sale = df[sale_mask].copy()\nexcept Exception as e:\n    df_sale = df.copy()\n\ntry:\n    metric_cols = ['Weight', 'Linehaul', 'Fuel Surcharge', 'Accessorials', 'Total Charge']\n    eda = {}\n    for col in metric_cols:\n        s = df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": int(s.count())\n        }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\ntry:\n    last_date = df_sale['Ship Date'].max()\n\n    def is_on_time(row):\n        dbp = row.get('days_before_promise', None)\n        td = row.get('transit_days', None)\n        if pd.isna(td) or td < 0:\n            return None\n        if not pd.isna(dbp) and dbp >= 0:\n            return True\n        days_late = row.get('days_late', None)\n        if not pd.isna(days_late) and days_late > 0:\n            return False\n        status_lower = str(row.get('Status', '')).lower()\n        rts_statuses = {'returned to sender', 'return to sender', 'rts', 'returned', 'refused'}\n        if status_lower in rts_statuses:\n            return False\n        dpd = row.get('days_past_due', None)\n        open_statuses = {\n            'in transit', 'out for delivery', 'picked up', 'exception',\n            'delivery exception', 'delayed', 'tendered', 'booked', 'dispatched',\n            'pending', 'shipped', 'partially shipped', 'backordered',\n            'short shipped', 'open', 'allocated', 'released', 'picked', 'packed'\n        }\n        if not pd.isna(dpd) and dpd > 0 and status_lower in open_statuses:\n            return False\n        return None\n\n    df_sale['_ot'] = df_sale.apply(is_on_time, axis=1)\n    df_judged = df_sale[df_sale['_ot'].notna()].copy()\n\n    carriers = df_judged['Carrier'].dropna().unique()\n    carrier_results = []\n    for carrier in carriers:\n        sub = df_judged[df_judged['Carrier'] == carrier]\n        n_total = sub['Shipment ID'].nunique()\n        n_ontime = sub[sub['_ot'] == True]['Shipment ID'].nunique()\n        rate = n_ontime / n_total if n_total > 0 else 0.0\n        carrier_results.append({\"name\": str(carrier), \"value\": round(float(rate), 6)})\n\n    carrier_results_sorted = sorted(carrier_results, key=lambda x: x['value'], reverse=True)\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Shipment ID\",\n        \"aggregation\": \"ratio\",\n        \"label\": \"on_time_delivery\",\n        \"results\": carrier_results_sorted\n    })\nexcept Exception:\n    pass\n\ntry:\n    tc_by_carrier = []\n    for carrier, grp in df_sale.groupby('Carrier'):\n        val = float(grp['Total Charge'].sum())\n        tc_by_carrier.append({\"name\": str(carrier), \"value\": round(val, 4)})\n    tc_by_carrier_sorted = sorted(tc_by_carrier, key=lambda x: x['value'], reverse=True)[:10]\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Total Charge\",\n        \"aggregation\": \"sum\",\n        \"label\": None,\n        \"results\": tc_by_carrier_sorted\n    })\nexcept Exception:\n    pass\n\ntry:\n    mean_tc_by_carrier = []\n    for carrier, grp in df_sale.groupby('Carrier'):\n        val = float(grp['Total Charge'].mean())\n        mean_tc_by_carrier.append({\"name\": str(carrier), \"value\": round(val, 4)})\n    mean_tc_by_carrier_sorted = sorted(mean_tc_by_carrier, key=lambda x: x['value'], reverse=True)[:10]\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Total Charge\",\n        \"aggregation\": \"mean\",\n        \"label\": None,\n        \"results\": mean_tc_by_carrier_sorted\n    })\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Only 'sale' rows in USD are used for segmentation and on-time delivery.\",\n    \"On-time delivery denominator includes delivered, RTS, and open-past-due shipments; open-not-yet-due excluded.\",\n    \"On-time rate computed as distinct shipment IDs on time / distinct shipment IDs judged.\",\n    \"EDA summary covers all rows as loaded (no row_kind filter), per domain rules.\",\n    \"transit_days and days_before_promise columns used as provided; not recomputed.\"\n]", "result_excerpt": "{\"segment_column\": \"Carrier\", \"metric_column\": \"Shipment ID\", \"aggregation\": \"ratio\", \"results\": [{\"name\": \"UPS\", \"value\": 0.962085}, {\"name\": \"Old Dominion\", \"value\": 0.94964}, {\"name\": \"FedEx Freight\", \"value\": 0.906728}, {\"name\": \"XPO\", \"value\": 0.819512}, {\"name\": \"J.B. Hunt\", \"value\": 0.70155}], \"label\": \"on_time_delivery\"}", "row_count": 3000, "confidence": "high", "confidence_reason": "3000 rows", "assumptions": []}, {"id": "seg:Carrier/Total Charge:sum", "kind": "segment", "claim": "sum Total Charge by Carrier (5 groups)", "code": "try:\n    sale_mask = (df['row_kind'] == 'sale') & (df['Currency'] == 'USD')\n    df_sale = df[sale_mask].copy()\nexcept Exception as e:\n    df_sale = df.copy()\n\ntry:\n    metric_cols = ['Weight', 'Linehaul', 'Fuel Surcharge', 'Accessorials', 'Total Charge']\n    eda = {}\n    for col in metric_cols:\n        s = df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": int(s.count())\n        }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\ntry:\n    last_date = df_sale['Ship Date'].max()\n\n    def is_on_time(row):\n        dbp = row.get('days_before_promise', None)\n        td = row.get('transit_days', None)\n        if pd.isna(td) or td < 0:\n            return None\n        if not pd.isna(dbp) and dbp >= 0:\n            return True\n        days_late = row.get('days_late', None)\n        if not pd.isna(days_late) and days_late > 0:\n            return False\n        status_lower = str(row.get('Status', '')).lower()\n        rts_statuses = {'returned to sender', 'return to sender', 'rts', 'returned', 'refused'}\n        if status_lower in rts_statuses:\n            return False\n        dpd = row.get('days_past_due', None)\n        open_statuses = {\n            'in transit', 'out for delivery', 'picked up', 'exception',\n            'delivery exception', 'delayed', 'tendered', 'booked', 'dispatched',\n            'pending', 'shipped', 'partially shipped', 'backordered',\n            'short shipped', 'open', 'allocated', 'released', 'picked', 'packed'\n        }\n        if not pd.isna(dpd) and dpd > 0 and status_lower in open_statuses:\n            return False\n        return None\n\n    df_sale['_ot'] = df_sale.apply(is_on_time, axis=1)\n    df_judged = df_sale[df_sale['_ot'].notna()].copy()\n\n    carriers = df_judged['Carrier'].dropna().unique()\n    carrier_results = []\n    for carrier in carriers:\n        sub = df_judged[df_judged['Carrier'] == carrier]\n        n_total = sub['Shipment ID'].nunique()\n        n_ontime = sub[sub['_ot'] == True]['Shipment ID'].nunique()\n        rate = n_ontime / n_total if n_total > 0 else 0.0\n        carrier_results.append({\"name\": str(carrier), \"value\": round(float(rate), 6)})\n\n    carrier_results_sorted = sorted(carrier_results, key=lambda x: x['value'], reverse=True)\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Shipment ID\",\n        \"aggregation\": \"ratio\",\n        \"label\": \"on_time_delivery\",\n        \"results\": carrier_results_sorted\n    })\nexcept Exception:\n    pass\n\ntry:\n    tc_by_carrier = []\n    for carrier, grp in df_sale.groupby('Carrier'):\n        val = float(grp['Total Charge'].sum())\n        tc_by_carrier.append({\"name\": str(carrier), \"value\": round(val, 4)})\n    tc_by_carrier_sorted = sorted(tc_by_carrier, key=lambda x: x['value'], reverse=True)[:10]\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Total Charge\",\n        \"aggregation\": \"sum\",\n        \"label\": None,\n        \"results\": tc_by_carrier_sorted\n    })\nexcept Exception:\n    pass\n\ntry:\n    mean_tc_by_carrier = []\n    for carrier, grp in df_sale.groupby('Carrier'):\n        val = float(grp['Total Charge'].mean())\n        mean_tc_by_carrier.append({\"name\": str(carrier), \"value\": round(val, 4)})\n    mean_tc_by_carrier_sorted = sorted(mean_tc_by_carrier, key=lambda x: x['value'], reverse=True)[:10]\n\n    result['segments'].append({\n        \"segment_column\": \"Carrier\",\n        \"metric_column\": \"Total Charge\",\n        \"aggregation\": \"mean\",\n        \"label\": None,\n        \"results\": mean_tc_by_carrier_sorted\n    })\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Only 'sale' rows in USD are used for segmentation and on-time delivery.\",\n    \"On-time delivery denominator includes delivered, RTS, and open-past-due shipments; open-not-yet-due excluded.\",\n    \"On-time rate computed as distinct shipment IDs on time / distinct shipment IDs judged.\",\n    \"EDA summary covers all rows as loaded (no row_kind filter), per domain rules.\",\n    \"transit_days and days_before_promise columns used as provided; not recomputed.\"\n]", "result_excerpt": "{\"segment_column\": \"Carrier\", \"metric_column\": \"Total Charge\", \"aggregation\": \"sum\", \"results\": [{\"name\": \"FedEx Freight\", \"value\": 200941.87}, {\"name\": \"UPS\", \"value\": 182665.04}, {\"name\": \"Old Dominion\", \"value\": 180988.26}, {\"name\": \"J.B. Hunt\", \"value\": 76615.0}, {\"name\": \"XPO\", \"value\": 62300.94}]}", "row_count": 3000, "confidence": "high", "confidence_reason": "3000 rows", "assumptions": []}, {"id": "seg:Carrier/Total Charge", "kind": "segment", "claim": "mean Total Charge by Carrier (5 groups)", "code": "try:\n    sale_mask = (df['row_kind'] == 'sale') & (df['Currency'] == 'USD')\n    df_sale = df[sale_mask].copy()\nexcept Exception as e:\n    df_sale = df.copy()\n\ntry:\n    metric_cols = ['Weight', 'Linehaul', 'Fuel Surcharge', 'Accessorials', 'Total Charge']\n    eda = {}\n    for col in metric_cols:\n        s = df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": i