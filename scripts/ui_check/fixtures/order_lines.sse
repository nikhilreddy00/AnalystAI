data: {"type": "expert_review", "data": {"review_summary": "12 claims checked against the evidence; 1 flagged (1 contradicted).", "strengths": [], "gaps": ["The report does not analyze transit time (calendar days from ship date) or on-time performance by carrier, which would help explain the 63.3% OTIF order rate and identify which carriers or lanes drive the gap.", "No breakdown of OTIF or fill rates by order type, customer, or geography (Ship To) is provided, limiting the ability to target improvement efforts.", "The 76 rows where Quantity Shipped exceeds Quantity Ordered are flagged but not analyzed; their impact on fill-rate calculations and whether they represent data errors or legitimate over-shipments is unknown."], "next_investigations": ["Analyze OTIF (on-time and in-full) by Carrier and Warehouse to identify which combinations drive the 63.3% order-level OTIF rate and where improvements would have the most impact.", "Examine the 76 rows where Quantity Shipped exceeds Quantity Ordered to determine whether they are data errors, legitimate over-shipments, or a specific order type, and recalculate fill rates excluding or correcting them.", "Compare Backordered volume and Delivered Quantity Ordered trends by Warehouse and Carrier to understand whether the October rise in backorders is concentrated in specific lanes or warehouses."], "methodology_concerns": ["Backordered trend (claim 6) is based on only 15 rows with low confidence; the 207% rise may not be actionable and could reflect random variation or a single large order.", "The 7-day rolling trend for Quantity Shipped shows a -58.2% decline, but this is computed by the model's own code rather than the built-in rule used for the reported figures, and it excludes the 110 cancelled rows. Its relevance to the dataset overview is unclear.", "Carrier and warehouse comparisons are associations, not causal; differences depend on lanes, modes, and shippers served, as noted in the report preamble. The report does not control for these factors."], "flags": [{"index": 0, "section": "headline", "claim": "This logistics dataset covers 6,025 order lines across 8 months (Mar\u2013Oct 2026), with an overall OTIF order rate of 63.3% and a unit fill rate of 96.7%.", "label": "contradicted", "kind": "number", "reason": "calls the file's 6,025 rows orders: the data has 1,993 orders", "evidence_ids": ["source:data", "clean:audit"], "source": "check"}], "generated_at": "2026-11-18T17:52:34.295477Z"}}

