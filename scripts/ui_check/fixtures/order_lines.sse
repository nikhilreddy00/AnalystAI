ount: 110 other rows left out.\n_period = pd.to_datetime(df['Order Date'], format='mixed').dt.to_period('M'); df.groupby(_period)['Qty Ordered'].sum()", "confidence": "high"}, "placement": "summary", "lint_warnings": [], "error_key": null, "split_key": null, "reference_lines": []}, {"id": "ac8dd9eb-a394-4799-a893-f9bc3ab8dae6", "chart_type": "BarChart", "title": "Total Quantity Ordered by Warehouse: Reno DC highest (62,757.00), Columbus DC lowest (29,844.00)", "data": [{"Warehouse": "Reno DC", "Qty Ordered": 62757.0, "Qty Ordered__n": 2592}, {"Warehouse": "Dallas DC", "Qty Ordered": 51541.0, "Qty Ordered__n": 2104}, {"Warehouse": "Columbus DC", "Qty Ordered": 29844.0, "Qty Ordered__n": 1219}], "x_key": "Warehouse", "y_keys": ["Qty Ordered"], "colors": [], "x_label": "Warehouse", "y_label": "Total Quantity Ordered", "show_legend": false, "show_grid": true, "source_finding": "group_bars", "value_format": "number", "layout_hint": "half_width", "rationale": {"rule": "segment\u2192bars", "reason": "Compares sum Qty Ordered across Warehouse; totals have no sampling error, so no interval.", "x": "Warehouse", "y": "Qty Ordered", "split": null, "aggregation": "sum", "n_rows": 5915, "evidence_ids": ["seg:Warehouse/Qty Ordered:sum"], "code": "df.groupby('Warehouse')['Qty Ordered'].sum()", "confidence": "high"}, "placement": "summary", "lint_warnings": [], "error_key": null, "split_key": null, "reference_lines": []}]}

