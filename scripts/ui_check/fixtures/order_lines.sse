data: {"type": "evidence", "data": [{"id": "source:data", "kind": "source", "claim": "Loaded 6,025 rows \u00d7 13 columns from a XLSX file.", "code": "pd.read_excel(<uploaded file>, sheet_name=<largest sheet>)", "result_excerpt": "{\"roles\": {\"id\": [\"Order ID\", \"Line No\", \"Order Line ID\", \"SKU\"], \"date\": [\"Order Date\", \"Requested Date\", \"Delivered Date\"], \"metric\": [\"Qty Ordered\", \"Qty Shipped\"], \"category\": [\"Status\", \"Warehouse\", \"Carrier\", \"Ship To\"]}, \"personal_data\": {}, \"fingerprint\": \"a96a0eba4a2661e6\"}", "row_count": 6025, "confidence": "high", "confidence_reason": "Read as-is: no layout guessing was needed.", "assumptions": []}, {"id": "clean:audit", "kind": "cleaning", "claim": "Cleaning: 6025 \u2192 6025 rows, 3 logged changes", "code": "# cleaning rules-v1\nkeep('Delivered Date', conditional)\nflag('*', cancel)\nflag('shipped_minus_ordered', out_of_range)", "result_excerpt": "{\"rows_before\": 6025, \"rows_after\": 6025, \"decisions\": [[\"Delivered Date\", \"keep\", 0, 0], [\"*\", \"flag\", 110, 0], [\"shipped_minus_ordered\", \"flag\", 76, 0]]}", "row_count": 6025, "confidence": "high", "confidence_reason": "rule-based; every change below is logged", "assumptions": ["Delivered Date: Filled only for rows whose status needs it, so other rows are blank by design; 0% of those rows have no value. Kept as it is.", "*: 110 cancelled shipments, lines or appointments: left out of every count and rate; kept in the data.", "shipped_minus_ordered: 76 values outside the valid range (le 0); kept, check them."]}, {"id": "corr:Qty Ordered__Qty Shipped", "kind": "correlation", "claim": "Qty Ordered and Qty Shipped: r = 0.922", "code": "try:\n    sale_df = df[df['row_kind'] == 'sale'].copy()\nexcept Exception:\n    sale_df = df.copy()\n\n# EDA\ntry:\n    metric_cols = ['Qty Ordered', 'Qty Shipped']\n    eda = {}\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": int(s.count())\n        }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# CORRELATIONS\ntry:\n    num_cols = sale_df[metric_cols].dropna()\n    corr_dict = {}\n    for i, c1 in enumerate(metric_cols):\n        for c2 in metric_cols[i+1:]:\n            pair = num_cols[[c1, c2]].dropna()\n            if len(pair) > 1:\n                r = float(pair[c1].corr(pair[c2]))\n                if abs(r) >= 0.2:\n                    corr_dict[f\"{c1}__{c2}\"] = round(r, 4)\n    result['correlations'] = corr_dict\nexcept Exception:\n    pass\n\n# SEGMENTATION\ntry:\n    seg_results = []\n    segment_cols = ['Status', 'Warehouse', 'Carrier']\n    for seg in segment_cols:\n        for metric in metric_cols:\n            grp = sale_df.groupby(seg)[metric].sum().nlargest(10)\n            seg_results.append({\n                \"segment_column\": seg,\n                \"metric_column\": metric,\n                \"aggregation\": \"sum\",\n                \"label\": None,\n                \"results\": [{\"name\": str(k), \"value\": float(v)} for k, v in grp.items()]\n            })\n\n    # Unit fill rate by Warehouse\n    judged_statuses = ['delivered', 'backordered', 'returned', 'short shipped', 'partially shipped', 'shipped']\n    judged = sale_df[~sale_df['Status'].str.lower().isin(['open','pending','allocated','released','picked','packed'])]\n    for seg in ['Warehouse', 'Carrier']:\n        grp_num = judged.groupby(seg)['Qty Shipped'].sum()\n        grp_den = judged.groupby(seg)['Qty Ordered'].sum()\n        ratio = (grp_num / grp_den).dropna().nlargest(10)\n        seg_results.append({\n            \"segment_column\": seg,\n            \"metric_column\": \"Qty Shipped\",\n            \"aggregation\": \"ratio\",\n            \"label\": \"unit_fill\",\n            \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in ratio.items()]\n        })\n\n    # Line fill rate by Status\n    judged2 = judged.copy()\n    judged2['_full'] = judged2['shipped_minus_ordered'] >= 0\n    line_fill_num = judged2.groupby('Status')['_full'].sum()\n    line_fill_den = judged2.groupby('Status')['Order Line ID'].nunique()\n    line_fill = (line_fill_num / line_fill_den).dropna().nlargest(10)\n    seg_results.append({\n        \"segment_column\": \"Status\",\n        \"metric_column\": \"Order Line ID\",\n        \"aggregation\": \"ratio\",\n        \"label\": \"line_fill\",\n        \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in line_fill.items()]\n    })\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# ANOMALIES\ntry:\n    anomalies = []\n    import numpy as np\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if s.min() < 0:\n            shift = -s.min()\n        if abs(skew) > 2:\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1 = s_t.quantile(0.25)\n        q3 = s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        flagged = s_t[(s_t < lo) | (s_t > hi)]\n        if len(flagged) / len(s_t) > 0.05:\n            anomalies.append({\n                \"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\",\n                \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually\"\n            })\n            continue\n        lo_orig = float(np.expm1(lo) - shift) if abs(skew) > 2 else float(lo)\n        hi_orig = float(np.expm1(hi) - shift) if abs(skew) > 2 else float(hi)\n        lo4 = q1 - 4 * iqr; hi4 = q3 + 4 * iqr\n        lo5 = q1 - 5 * iqr; hi5 = q3 + 5 * iqr\n        for idx in flagged.index:\n            if len(anomalies) >= 25:\n                break\n            raw_val = float(s.loc[idx])\n            tv = float(s_t.loc[idx])\n            if tv < lo5 or tv > hi5:\n                sev = \"critical\"\n            elif tv < lo4 or tv > hi4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            exp_range = f\"[{lo_orig:.1f}, {hi_orig:.1f}]\"\n            anomalies.append({\n                \"column\": col,\n                \"row_index\": int(idx),\n                \"value\": raw_val,\n                \"expected_range\": exp_range,\n                \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val} lies outside expected range {exp_range}\"\n            })\n    result['anomalies'] = anomalies\nexcept Exception:\n    pass\n\n# TRENDS\ntry:\n    import pandas as pd\n    trends = []\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    sale_df['_ym'] = sale_df['_order_date'].dt.to_period('M')\n    for metric in metric_cols:\n        monthly = sale_df.groupby('_ym')[metric].sum().sort_index()\n        if len(monthly) >= 2:\n            pct = float((monthly.iloc[-1] - monthly.iloc[-2]) / monthly.iloc[-2] * 100) if monthly.iloc[-2] != 0 else 0.0\n            direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n            trends.append({\n                \"column\": metric,\n                \"period\": \"MoM\",\n                \"direction\": direction,\n                \"pct_change\": round(pct, 2),\n                \"segment\": None\n            })\n    # 7d rolling trend on Qty Shipped\n    daily = sale_df.groupby(sale_df['_order_date'].dt.date)['Qty Shipped'].sum().reset_index()\n    daily.columns = ['date', 'qty']\n    daily = daily.sort_values('date')\n    if len(daily) >= 14:\n        roll = daily['qty'].rolling(7).mean()\n        last7 = float(roll.iloc[-1])\n        prev7 = float(roll.iloc[-8]) if len(roll) >= 8 else float(roll.iloc[0])\n        pct7 = (last7 - prev7) / prev7 * 100 if prev7 != 0 else 0.0\n        direction7 = \"up\" if pct7 > 1 else (\"down\" if pct7 < -1 else \"flat\")\n        trends.append({\n            \"column\": \"Qty Shipped\",\n            \"period\": \"7d_rolling\",\n            \"direction\": direction7,\n            \"pct_change\": round(float(pct7), 2),\n            \"segment\": None\n        })\n    result['trends'] = trends\nexcept Exception:\n    pass\n\n# FORECASTING (simple linear extrapolation on monthly Qty Shipped)\ntry:\n    import numpy as np\n    import pandas as pd\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    monthly_ship = sale_df.groupby(sale_df['_order_date'].dt.to_period('M'))['Qty Shipped'].sum().sort_index()\n    if len(monthly_ship) >= 3:\n        x = np.arange(len(monthly_ship))\n        y = monthly_ship.values.astype(float)\n        coeffs = np.polyfit(x, y, 1)\n        next_x = len(monthly_ship)\n        next_val = float(np.polyval(coeffs, next_x))\n        next_period = str(monthly_ship.index[-1] + 1)\n        result['forecast_points'] = [{\"period\": next_period, \"value\": round(next_val, 2)}]\nexcept Exception:\n    pass\n\n# ASSUMPTIONS\nresult['assumptions'] = [\n    \"Only 'sale' rows (row_kind='sale') are used for all KPIs and segmentation.\",\n    \"Unit fill and line fill exclude open/pending/allocated/released/picked/packed lines.\",\n    \"Correlations are Pearson r; only |r| >= 0.2 reported.\",\n    \"Anomaly IQR uses 3x boundary; columns flagging >5% of rows treated as heavy-tailed.\",\n    \"Forecast is a linear extrapolation of monthly Qty Shipped totals \u2014 indicative only.\"\n]", "result_excerpt": "{\"Qty Ordered__Qty Shipped\": 0.9219}", "row_count": 6025, "confidence": "high", "confidence_reason": "6025 rows", "assumptions": ["Qty Shipped 7d_rolling: computed by the model's own code, not by the built-in rule the figures use (Only the rows the figures count: 110 other rows left out)", "Qty Ordered by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Warehouse recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Carrier recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Shipped:7d_rolling", "kind": "trend", "claim": "Qty Shipped 7d_rolling: -58.2%", "code": "try:\n    sale_df = df[df['row_kind'] == 'sale'].copy()\nexcept Exception:\n    sale_df = df.copy()\n\n# EDA\ntry:\n    metric_cols = ['Qty Ordered', 'Qty Shipped']\n    eda = {}\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": int(s.count())\n        }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# CORRELATIONS\ntry:\n    num_cols = sale_df[metric_cols].dropna()\n    corr_dict = {}\n    for i, c1 in enumerate(metric_cols):\n        for c2 in metric_cols[i+1:]:\n            pair = num_cols[[c1, c2]].dropna()\n            if len(pair) > 1:\n                r = float(pair[c1].corr(pair[c2]))\n                if abs(r) >= 0.2:\n                    corr_dict[f\"{c1}__{c2}\"] = round(r, 4)\n    result['correlations'] = corr_dict\nexcept Exception:\n    pass\n\n# SEGMENTATION\ntry:\n    seg_results = []\n    segment_cols = ['Status', 'Warehouse', 'Carrier']\n    for seg in segment_cols:\n        for metric in metric_cols:\n            grp = sale_df.groupby(seg)[metric].sum().nlargest(10)\n            seg_results.append({\n                \"segment_column\": seg,\n                \"metric_column\": metric,\n                \"aggregation\": \"sum\",\n                \"label\": None,\n                \"results\": [{\"name\": str(k), \"value\": float(v)} for k, v in grp.items()]\n            })\n\n    # Unit fill rate by Warehouse\n    judged_statuses = ['delivered', 'backordered', 'returned', 'short shipped', 'partially shipped', 'shipped']\n    judged = sale_df[~sale_df['Status'].str.lower().isin(['open','pending','allocated','released','picked','packed'])]\n    for seg in ['Warehouse', 'Carrier']:\n        grp_num = judged.groupby(seg)['Qty Shipped'].sum()\n        grp_den = judged.groupby(seg)['Qty Ordered'].sum()\n        ratio = (grp_num / grp_den).dropna().nlargest(10)\n        seg_results.append({\n            \"segment_column\": seg,\n            \"metric_column\": \"Qty Shipped\",\n            \"aggregation\": \"ratio\",\n            \"label\": \"unit_fill\",\n            \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in ratio.items()]\n        })\n\n    # Line fill rate by Status\n    judged2 = judged.copy()\n    judged2['_full'] = judged2['shipped_minus_ordered'] >= 0\n    line_fill_num = judged2.groupby('Status')['_full'].sum()\n    line_fill_den = judged2.groupby('Status')['Order Line ID'].nunique()\n    line_fill = (line_fill_num / line_fill_den).dropna().nlargest(10)\n    seg_results.append({\n        \"segment_column\": \"Status\",\n        \"metric_column\": \"Order Line ID\",\n        \"aggregation\": \"ratio\",\n        \"label\": \"line_fill\",\n        \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in line_fill.items()]\n    })\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# ANOMALIES\ntry:\n    anomalies = []\n    import numpy as np\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if s.min() < 0:\n            shift = -s.min()\n        if abs(skew) > 2:\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1 = s_t.quantile(0.25)\n        q3 = s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        flagged = s_t[(s_t < lo) | (s_t > hi)]\n        if len(flagged) / len(s_t) > 0.05:\n            anomalies.append({\n                \"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\",\n                \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually\"\n            })\n            continue\n        lo_orig = float(np.expm1(lo) - shift) if abs(skew) > 2 else float(lo)\n        hi_orig = float(np.expm1(hi) - shift) if abs(skew) > 2 else float(hi)\n        lo4 = q1 - 4 * iqr; hi4 = q3 + 4 * iqr\n        lo5 = q1 - 5 * iqr; hi5 = q3 + 5 * iqr\n        for idx in flagged.index:\n            if len(anomalies) >= 25:\n                break\n            raw_val = float(s.loc[idx])\n            tv = float(s_t.loc[idx])\n            if tv < lo5 or tv > hi5:\n                sev = \"critical\"\n            elif tv < lo4 or tv > hi4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            exp_range = f\"[{lo_orig:.1f}, {hi_orig:.1f}]\"\n            anomalies.append({\n                \"column\": col,\n                \"row_index\": int(idx),\n                \"value\": raw_val,\n                \"expected_range\": exp_range,\n                \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val} lies outside expected range {exp_range}\"\n            })\n    result['anomalies'] = anomalies\nexcept Exception:\n    pass\n\n# TRENDS\ntry:\n    import pandas as pd\n    trends = []\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    sale_df['_ym'] = sale_df['_order_date'].dt.to_period('M')\n    for metric in metric_cols:\n        monthly = sale_df.groupby('_ym')[metric].sum().sort_index()\n        if len(monthly) >= 2:\n            pct = float((monthly.iloc[-1] - monthly.iloc[-2]) / monthly.iloc[-2] * 100) if monthly.iloc[-2] != 0 else 0.0\n            direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n            trends.append({\n                \"column\": metric,\n                \"period\": \"MoM\",\n                \"direction\": direction,\n                \"pct_change\": round(pct, 2),\n                \"segment\": None\n            })\n    # 7d rolling trend on Qty Shipped\n    daily = sale_df.groupby(sale_df['_order_date'].dt.date)['Qty Shipped'].sum().reset_index()\n    daily.columns = ['date', 'qty']\n    daily = daily.sort_values('date')\n    if len(daily) >= 14:\n        roll = daily['qty'].rolling(7).mean()\n        last7 = float(roll.iloc[-1])\n        prev7 = float(roll.iloc[-8]) if len(roll) >= 8 else float(roll.iloc[0])\n        pct7 = (last7 - prev7) / prev7 * 100 if prev7 != 0 else 0.0\n        direction7 = \"up\" if pct7 > 1 else (\"down\" if pct7 < -1 else \"flat\")\n        trends.append({\n            \"column\": \"Qty Shipped\",\n            \"period\": \"7d_rolling\",\n            \"direction\": direction7,\n            \"pct_change\": round(float(pct7), 2),\n            \"segment\": None\n        })\n    result['trends'] = trends\nexcept Exception:\n    pass\n\n# FORECASTING (simple linear extrapolation on monthly Qty Shipped)\ntry:\n    import numpy as np\n    import pandas as pd\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    monthly_ship = sale_df.groupby(sale_df['_order_date'].dt.to_period('M'))['Qty Shipped'].sum().sort_index()\n    if len(monthly_ship) >= 3:\n        x = np.arange(len(monthly_ship))\n        y = monthly_ship.values.astype(float)\n        coeffs = np.polyfit(x, y, 1)\n        next_x = len(monthly_ship)\n        next_val = float(np.polyval(coeffs, next_x))\n        next_period = str(monthly_ship.index[-1] + 1)\n        result['forecast_points'] = [{\"period\": next_period, \"value\": round(next_val, 2)}]\nexcept Exception:\n    pass\n\n# ASSUMPTIONS\nresult['assumptions'] = [\n    \"Only 'sale' rows (row_kind='sale') are used for all KPIs and segmentation.\",\n    \"Unit fill and line fill exclude open/pending/allocated/released/picked/packed lines.\",\n    \"Correlations are Pearson r; only |r| >= 0.2 reported.\",\n    \"Anomaly IQR uses 3x boundary; columns flagging >5% of rows treated as heavy-tailed.\",\n    \"Forecast is a linear extrapolation of monthly Qty Shipped totals \u2014 indicative only.\"\n]", "result_excerpt": "{\"column\": \"Qty Shipped\", \"period\": \"7d_rolling\", \"direction\": \"down\", \"pct_change\": -58.19, \"segment\": null}", "row_count": 6025, "confidence": "high", "confidence_reason": "6025 rows", "assumptions": ["Qty Shipped 7d_rolling: computed by the model's own code, not by the built-in rule the figures use (Only the rows the figures count: 110 other rows left out)", "Qty Shipped by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Warehouse recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Carrier recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Ordered:MoM", "kind": "trend", "claim": "Qty Ordered MoM: +10.8%", "code": "# built-in statistics, computed in-process (agents/analysis_agent.standard_stats)\ndef standard_stats(raw: dict, df: pd.DataFrame, contract: DataContract, task: AnalysisTask) -> None:\n    \"\"\"Statistics with one right answer, computed in this process with the shared functions (plan\n    v2 R2: they were a second copy of the rules, as code text run in the sandbox, and drifted).\n    Merged into the sandbox's `raw` result as before: a target's MoM (and YoY on a pack's data)\n    replaces the model's; target-pair r and the joint breakdown fill gaps; a level by segment\n    replaces only the model's totals and means of it. Ids go to raw['builtin'] (evidence).\"\"\"\n    from agents.utils import (LevelUnavailable, aggregate, cut_partial, effective_agg, latest_rows, pct_change, ranked,\n                              time_axis, weekly_cadence)\n    from domain_pack import entity_rows, rows_for\n    types = {t.value if hasattr(t, \"value\") else t for t in task.analysis_types}\n    names = set(df.columns)\n    targets = [c for c in task.target_metrics if c in contract.metric_columns and c in names]\n    segs = [c for c in task.segments if c in names]\n    # a column's summary over the rows its tiles count (a claim's replaced and voided versions\n    # out, as every answer and chart): replaces the sandbox's every-row summary of that column\n    for c in (c for c in contract.metric_columns if c in names):\n        if (summary := counted_summary(df, contract, c)) is not None:\n            raw.setdefault(\"eda_summary\", {})[c] = summary\n    for key, empty in ((\"builtin\", []), (\"correlations\", {}), (\"trends\", []), (\"segments\", []),\n                       (\"assumptions\", [])):\n        raw.setdefault(key, empty)\n    level = {c.name for c in contract.columns if c.aggregation in (\"last\", \"first\")}\n\n    if types & {\"correlation\", \"hypothesis\"}:   # snapshot data: one row per entity\n        cdf = entity_rows(df, contract)\n        for i, a in enumerate(targets):\n            for b in targets[i + 1:]:\n                if f\"{a}__{b}\" in raw[\"correlations\"] or f\"{b}__{a}\" in raw[\"correlations\"]:\n                    continue\n                r = pd.to_numeric(cdf[a], errors=\"coerce\").corr(pd.to_numeric(cdf[b], errors=\"coerce\"))\n                if r == r:\n                    raw[\"correlations\"][f\"{a}__{b}\"] = round(float(r), 4)\n                    raw[\"builtin\"].append(f\"corr:{a}__{b}\")\n\n    yoy = defaults_pack(contract) is not None\n    if types & {\"trend\", \"forecasting\"} and targets:\n        replaced = (\"MoM\", \"YoY\") if yoy else (\"MoM\",)\n        raw[\"trends\"] = [t for t in raw[\"trends\"] if not (isinstance(t, dict) and t.get(\"period\")\n                         in replaced and t.get(\"column\") in targets)]\n\n        def monthly(col: str):\n            \"\"\"(rows, their month, how a month is made) for `col`, judged once on the whole file:\n            the rows its tiles count, the main currency and a mid-month export's partial last\n            month (a segment's slice never re-judges them).\"\"\"\n            date = time_axis(contract, col, df)\n            agg = effective_agg(contract, col, None) or (\n                \"mean\" if pd.to_numeric(df[col], errors=\"coerce\").dropna().between(0, 1).all() else \"sum\")\n            if not date or (agg in (\"last\", \"first\") and col not in level):\n                return None\n            rows, m = counted_months(df, contract, col, date)\n            t = pd.to_datetime(rows[date], format=\"mixed\", errors=\"coerce\")\n            weeks = t.groupby(m).nunique() if yoy and agg == \"sum\" and weekly_cadence(t) else None\n            return rows.assign(_m=m), agg, weeks\n\n        def series_of(rows: pd.DataFrame, col: str, agg: str, weeks):\n            \"\"\"Calendar-month values: a level's month-ends, a flow's totals (a rate's means); weekly\n            data: each month is its average week.\"\"\"\n            try:\n                out = aggregate(rows[rows[\"_m\"].notna()], [\"_m\"], col, agg, contract,\n                                over_time=True).sort_index()\n            except LevelUnavailable:   # a level without its account column: no built-in trend\n                return None\n            if weeks is not None:\n                out = out / weeks.reindex(out.index)\n                note = \"Weekly data: each month is compared as its average week (months have 4 or 5 week-endings).\"\n                if note not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n            return out.dropna()\n\n        for c in targets:\n            made = monthly(c)\n            if made is None:\n                continue\n            rows, agg, weeks = made\n            overall = series_of(rows, c, agg, weeks)\n            if overall is None or len(overall) < 2:\n                continue\n            # a measure that develops (losses at a valuation): a change between young accident\n            # months is development, not a trend; no built-in MoM / YoY, the note says why\n            if note := developing_trend(contract, df, c):\n                if (note := f\"{c}:{note}\") not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n                continue\n            # the data's own last month (before partial / run-out months were left out)\n            data_last = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\",\n                                       errors=\"coerce\").dt.to_period(\"M\").max()\n            # every segment compares the same months as the whole file (never its own last two,\n            # which can be a stale pair); a flow's month with no rows is 0\n            last = overall.index[-1]\n            # a first month the data covers only part of (invoices from 26 Sep) is no month to\n            # compare with: utils.cut_partial, the one rule (Domain 6 live run: '+109% YoY'\n            # against five days of September)\n            dated = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\", errors=\"coerce\")\n            kept, _ = cut_partial(overall, dated, \"M\")\n            partial_first = overall.index[0] if len(kept) and kept.index[0] != overall.index[0] else None\n            pairs = [(k, p_) for k, p_ in ((\"MoM\", overall.index[-2]), (\"YoY\", last - 12 if yoy else None))\n                     if p_ != partial_first]\n            jobs = [(None, overall, rows)]\n            if segs:   # the 10 largest groups, ties by name (the same on every machine)\n                for v in ranked(df[segs[0]].value_counts()).head(10).index:\n                    part = rows[rows[segs[0]] == v]\n                    series = series_of(part, c, agg, weeks)\n                    if series is not None and agg == \"sum\":\n                        series = series.reindex(overall.index, fill_value=0)\n                    jobs.append((str(v), series, part))\n            for seg, series, part in jobs:\n                if series is None:\n                    continue\n                tag = f\"trend:{c}\" + (f\" ({seg})\" if seg else \"\")\n                for period, then in pairs:\n                    if then is None or then not in series.index or last not in series.index:\n                        continue\n                    pct = pct_change(series[last], series[then])\n                    if pct is None:\n                        continue\n                    pct = round(float(pct), 2)   # the direction says the stated figure\n                    n = int(part.loc[part[\"_m\"].isin([last, then]), c].notna().sum())\n                    named = {\"latest\": str(last), \"previous\": str(then)} if last != data_last else {}\n                    raw[\"trends\"].append({\"column\": c, \"period\": period, \"pct_change\": pct,\n                                          \"segment\": seg, \"n\": n, **named,\n                                          \"direction\": \"up\" if pct > 0 else \"down\" if pct < 0 else \"flat\"})\n                    raw[\"builtin\"].append(f\"{tag}:{period}\")\n\n    if \"segmentation\" in types:\n        keys = [[x] for x in segs] + ([segs[:2]] if len(segs) >= 2 else [])\n        for c in targets:\n            rows, _ = rows_for(df, contract, c)\n            if c in level:   # a level by segment: each entity's latest row (a closed or stopped\n                cur = latest_rows(rows, c, contract)   # account is out), totals and means\n                for k in keys:\n                    s_ = \"|\".join(k)\n                    raw[\"segments\"] = [x for x in raw[\"segments\"] if not (\n                        isinstance(x, dict) and x.get(\"segment_column\") == s_ and x.get(\"metric_column\") == c\n                        and str(x.get(\"aggregation\") or \"sum\").lower() in (\"sum\", \"total\", \"last\", \"first\",\n                                                                             \"mean\", \"avg\", \"average\"))]\n                    for agg, vals in ((\"last\", cur.groupby(k)[c].sum(min_count=1).dropna()),\n                                      (\"mean\", cur.groupby(k)[c].mean().dropna())):\n                        raw[\"segments\"].append({\"segment_column\": s_, \"metric_column\": c, \"aggregation\": agg,\n                                                \"results\": [{\"name\": \"|\".join(map(str, n)) if isinstance(n, tuple)\n                                                             else str(n), \"value\": round(float(v), 4)}\n                                                            for n, v in vals.items()]})\n                    raw[\"builtin\"].append(f\"seg:{s_}/{c}\")\n            elif len(segs) >= 2:   # the joint breakdown fills a gap\n                joint = \"|\".join(segs[:2])\n                if any(isinstance(x, dict) and x.get(\"segment_column\") == joint and x.get(\"metric_column\") == c\n                       for x in raw[\"segments\"]):\n                    continue\n                means = rows.groupby(segs[:2])[c].mean()\n                top = ranked(rows.groupby(segs[:2]).size()).head(20).index\n                raw[\"segments\"].append({\"segment_column\": joint, \"metric_column\": c, \"aggregation\": \"mean\",\n                                        \"results\": [{\"name\": f\"{a}|{b}\", \"value\": round(float(means[(a, b)]), 4)}\n                                                    for a, b in top]})\n                raw[\"builtin\"].append(f\"seg:{joint}/{c}\")\n    _drop_protected_cells(raw, df, contract)\n", "result_excerpt": "{\"column\": \"Qty Ordered\", \"period\": \"MoM\", \"direction\": \"up\", \"pct_change\": 10.8, \"segment\": null}", "row_count": 1511, "confidence": "high", "confidence_reason": "1511 rows", "assumptions": ["Qty Ordered by Status recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Ordered (Delivered):MoM", "kind": "trend", "claim": "Qty Ordered (Delivered) MoM: -14.8%", "code": "# built-in statistics, computed in-process (agents/analysis_agent.standard_stats)\ndef standard_stats(raw: dict, df: pd.DataFrame, contract: DataContract, task: AnalysisTask) -> None:\n    \"\"\"Statistics with one right answer, computed in this process with the shared functions (plan\n    v2 R2: they were a second copy of the rules, as code text run in the sandbox, and drifted).\n    Merged into the sandbox's `raw` result as before: a target's MoM (and YoY on a pack's data)\n    replaces the model's; target-pair r and the joint breakdown fill gaps; a level by segment\n    replaces only the model's totals and means of it. Ids go to raw['builtin'] (evidence).\"\"\"\n    from agents.utils import (LevelUnavailable, aggregate, cut_partial, effective_agg, latest_rows, pct_change, ranked,\n                              time_axis, weekly_cadence)\n    from domain_pack import entity_rows, rows_for\n    types = {t.value if hasattr(t, \"value\") else t for t in task.analysis_types}\n    names = set(df.columns)\n    targets = [c for c in task.target_metrics if c in contract.metric_columns and c in names]\n    segs = [c for c in task.segments if c in names]\n    # a column's summary over the rows its tiles count (a claim's replaced and voided versions\n    # out, as every answer and chart): replaces the sandbox's every-row summary of that column\n    for c in (c for c in contract.metric_columns if c in names):\n        if (summary := counted_summary(df, contract, c)) is not None:\n            raw.setdefault(\"eda_summary\", {})[c] = summary\n    for key, empty in ((\"builtin\", []), (\"correlations\", {}), (\"trends\", []), (\"segments\", []),\n                       (\"assumptions\", [])):\n        raw.setdefault(key, empty)\n    level = {c.name for c in contract.columns if c.aggregation in (\"last\", \"first\")}\n\n    if types & {\"correlation\", \"hypothesis\"}:   # snapshot data: one row per entity\n        cdf = entity_rows(df, contract)\n        for i, a in enumerate(targets):\n            for b in targets[i + 1:]:\n                if f\"{a}__{b}\" in raw[\"correlations\"] or f\"{b}__{a}\" in raw[\"correlations\"]:\n                    continue\n                r = pd.to_numeric(cdf[a], errors=\"coerce\").corr(pd.to_numeric(cdf[b], errors=\"coerce\"))\n                if r == r:\n                    raw[\"correlations\"][f\"{a}__{b}\"] = round(float(r), 4)\n                    raw[\"builtin\"].append(f\"corr:{a}__{b}\")\n\n    yoy = defaults_pack(contract) is not None\n    if types & {\"trend\", \"forecasting\"} and targets:\n        replaced = (\"MoM\", \"YoY\") if yoy else (\"MoM\",)\n        raw[\"trends\"] = [t for t in raw[\"trends\"] if not (isinstance(t, dict) and t.get(\"period\")\n                         in replaced and t.get(\"column\") in targets)]\n\n        def monthly(col: str):\n            \"\"\"(rows, their month, how a month is made) for `col`, judged once on the whole file:\n            the rows its tiles count, the main currency and a mid-month export's partial last\n            month (a segment's slice never re-judges them).\"\"\"\n            date = time_axis(contract, col, df)\n            agg = effective_agg(contract, col, None) or (\n                \"mean\" if pd.to_numeric(df[col], errors=\"coerce\").dropna().between(0, 1).all() else \"sum\")\n            if not date or (agg in (\"last\", \"first\") and col not in level):\n                return None\n            rows, m = counted_months(df, contract, col, date)\n            t = pd.to_datetime(rows[date], format=\"mixed\", errors=\"coerce\")\n            weeks = t.groupby(m).nunique() if yoy and agg == \"sum\" and weekly_cadence(t) else None\n            return rows.assign(_m=m), agg, weeks\n\n        def series_of(rows: pd.DataFrame, col: str, agg: str, weeks):\n            \"\"\"Calendar-month values: a level's month-ends, a flow's totals (a rate's means); weekly\n            data: each month is its average week.\"\"\"\n            try:\n                out = aggregate(rows[rows[\"_m\"].notna()], [\"_m\"], col, agg, contract,\n                                over_time=True).sort_index()\n            except LevelUnavailable:   # a level without its account column: no built-in trend\n                return None\n            if weeks is not None:\n                out = out / weeks.reindex(out.index)\n                note = \"Weekly data: each month is compared as its average week (months have 4 or 5 week-endings).\"\n                if note not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n            return out.dropna()\n\n        for c in targets:\n            made = monthly(c)\n            if made is None:\n                continue\n            rows, agg, weeks = made\n            overall = series_of(rows, c, agg, weeks)\n            if overall is None or len(overall) < 2:\n                continue\n            # a measure that develops (losses at a valuation): a change between young accident\n            # months is development, not a trend; no built-in MoM / YoY, the note says why\n            if note := developing_trend(contract, df, c):\n                if (note := f\"{c}:{note}\") not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n                continue\n            # the data's own last month (before partial / run-out months were left out)\n            data_last = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\",\n                                       errors=\"coerce\").dt.to_period(\"M\").max()\n            # every segment compares the same months as the whole file (never its own last two,\n            # which can be a stale pair); a flow's month with no rows is 0\n            last = overall.index[-1]\n            # a first month the data covers only part of (invoices from 26 Sep) is no month to\n            # compare with: utils.cut_partial, the one rule (Domain 6 live run: '+109% YoY'\n            # against five days of September)\n            dated = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\", errors=\"coerce\")\n            kept, _ = cut_partial(overall, dated, \"M\")\n            partial_first = overall.index[0] if len(kept) and kept.index[0] != overall.index[0] else None\n            pairs = [(k, p_) for k, p_ in ((\"MoM\", overall.index[-2]), (\"YoY\", last - 12 if yoy else None))\n                     if p_ != partial_first]\n            jobs = [(None, overall, rows)]\n            if segs:   # the 10 largest groups, ties by name (the same on every machine)\n                for v in ranked(df[segs[0]].value_counts()).head(10).index:\n                    part = rows[rows[segs[0]] == v]\n                    series = series_of(part, c, agg, weeks)\n                    if series is not None and agg == \"sum\":\n                        series = series.reindex(overall.index, fill_value=0)\n                    jobs.append((str(v), series, part))\n            for seg, series, part in jobs:\n                if series is None:\n                    continue\n                tag = f\"trend:{c}\" + (f\" ({seg})\" if seg else \"\")\n                for period, then in pairs:\n                    if then is None or then not in series.index or last not in series.index:\n                        continue\n                    pct = pct_change(series[last], series[then])\n                    if pct is None:\n                        continue\n                    pct = round(float(pct), 2)   # the direction says the stated figure\n                    n = int(part.loc[part[\"_m\"].isin([last, then]), c].notna().sum())\n                    named = {\"latest\": str(last), \"previous\": str(then)} if last != data_last else {}\n                    raw[\"trends\"].append({\"column\": c, \"period\": period, \"pct_change\": pct,\n                                          \"segment\": seg, \"n\": n, **named,\n                                          \"direction\": \"up\" if pct > 0 else \"down\" if pct < 0 else \"flat\"})\n                    raw[\"builtin\"].append(f\"{tag}:{period}\")\n\n    if \"segmentation\" in types:\n        keys = [[x] for x in segs] + ([segs[:2]] if len(segs) >= 2 else [])\n        for c in targets:\n            rows, _ = rows_for(df, contract, c)\n            if c in level:   # a level by segment: each entity's latest row (a closed or stopped\n                cur = latest_rows(rows, c, contract)   # account is out), totals and means\n                for k in keys:\n                    s_ = \"|\".join(k)\n                    raw[\"segments\"] = [x for x in raw[\"segments\"] if not (\n                        isinstance(x, dict) and x.get(\"segment_column\") == s_ and x.get(\"metric_column\") == c\n                        and str(x.get(\"aggregation\") or \"sum\").lower() in (\"sum\", \"total\", \"last\", \"first\",\n                                                                             \"mean\", \"avg\", \"average\"))]\n                    for agg, vals in ((\"last\", cur.groupby(k)[c].sum(min_count=1).dropna()),\n                                      (\"mean\", cur.groupby(k)[c].mean().dropna())):\n                        raw[\"segments\"].append({\"segment_column\": s_, \"metric_column\": c, \"aggregation\": agg,\n                                                \"results\": [{\"name\": \"|\".join(map(str, n)) if isinstance(n, tuple)\n                                                             else str(n), \"value\": round(float(v), 4)}\n                                                            for n, v in vals.items()]})\n                    raw[\"builtin\"].append(f\"seg:{s_}/{c}\")\n            elif len(segs) >= 2:   # the joint breakdown fills a gap\n                joint = \"|\".join(segs[:2])\n                if any(isinstance(x, dict) and x.get(\"segment_column\") == joint and x.get(\"metric_column\") == c\n                       for x in raw[\"segments\"]):\n                    continue\n                means = rows.groupby(segs[:2])[c].mean()\n                top = ranked(rows.groupby(segs[:2]).size()).head(20).index\n                raw[\"segments\"].append({\"segment_column\": joint, \"metric_column\": c, \"aggregation\": \"mean\",\n                                        \"results\": [{\"name\": f\"{a}|{b}\", \"value\": round(float(means[(a, b)]), 4)}\n                                                    for a, b in top]})\n                raw[\"builtin\"].append(f\"seg:{joint}/{c}\")\n    _drop_protected_cells(raw, df, contract)\n", "result_excerpt": "{\"column\": \"Qty Ordered\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -14.75, \"segment\": \"Delivered\"}", "row_count": 1319, "confidence": "high", "confidence_reason": "1319 rows", "assumptions": ["Qty Ordered by Status recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Ordered (Backordered):MoM", "kind": "trend", "claim": "Qty Ordered (Backordered) MoM: +207.0%", "code": "# built-in statistics, computed in-process (agents/analysis_agent.standard_stats)\ndef standard_stats(raw: dict, df: pd.DataFrame, contract: DataContract, task: AnalysisTask) -> None:\n    \"\"\"Statistics with one right answer, computed in this process with the shared functions (plan\n    v2 R2: they were a second copy of the rules, as code text run in the sandbox, and drifted).\n    Merged into the sandbox's `raw` result as before: a target's MoM (and YoY on a pack's data)\n    replaces the model's; target-pair r and the joint breakdown fill gaps; a level by segment\n    replaces only the model's totals and means of it. Ids go to raw['builtin'] (evidence).\"\"\"\n    from agents.utils import (LevelUnavailable, aggregate, cut_partial, effective_agg, latest_rows, pct_change, ranked,\n                              time_axis, weekly_cadence)\n    from domain_pack import entity_rows, rows_for\n    types = {t.value if hasattr(t, \"value\") else t for t in task.analysis_types}\n    names = set(df.columns)\n    targets = [c for c in task.target_metrics if c in contract.metric_columns and c in names]\n    segs = [c for c in task.segments if c in names]\n    # a column's summary over the rows its tiles count (a claim's replaced and voided versions\n    # out, as every answer and chart): replaces the sandbox's every-row summary of that column\n    for c in (c for c in contract.metric_columns if c in names):\n        if (summary := counted_summary(df, contract, c)) is not None:\n            raw.setdefault(\"eda_summary\", {})[c] = summary\n    for key, empty in ((\"builtin\", []), (\"correlations\", {}), (\"trends\", []), (\"segments\", []),\n                       (\"assumptions\", [])):\n        raw.setdefault(key, empty)\n    level = {c.name for c in contract.columns if c.aggregation in (\"last\", \"first\")}\n\n    if types & {\"correlation\", \"hypothesis\"}:   # snapshot data: one row per entity\n        cdf = entity_rows(df, contract)\n        for i, a in enumerate(targets):\n            for b in targets[i + 1:]:\n                if f\"{a}__{b}\" in raw[\"correlations\"] or f\"{b}__{a}\" in raw[\"correlations\"]:\n                    continue\n                r = pd.to_numeric(cdf[a], errors=\"coerce\").corr(pd.to_numeric(cdf[b], errors=\"coerce\"))\n                if r == r:\n                    raw[\"correlations\"][f\"{a}__{b}\"] = round(float(r), 4)\n                    raw[\"builtin\"].append(f\"corr:{a}__{b}\")\n\n    yoy = defaults_pack(contract) is not None\n    if types & {\"trend\", \"forecasting\"} and targets:\n        replaced = (\"MoM\", \"YoY\") if yoy else (\"MoM\",)\n        raw[\"trends\"] = [t for t in raw[\"trends\"] if not (isinstance(t, dict) and t.get(\"period\")\n                         in replaced and t.get(\"column\") in targets)]\n\n        def monthly(col: str):\n            \"\"\"(rows, their month, how a month is made) for `col`, judged once on the whole file:\n            the rows its tiles count, the main currency and a mid-month export's partial last\n            month (a segment's slice never re-judges them).\"\"\"\n            date = time_axis(contract, col, df)\n            agg = effective_agg(contract, col, None) or (\n                \"mean\" if pd.to_numeric(df[col], errors=\"coerce\").dropna().between(0, 1).all() else \"sum\")\n            if not date or (agg in (\"last\", \"first\") and col not in level):\n                return None\n            rows, m = counted_months(df, contract, col, date)\n            t = pd.to_datetime(rows[date], format=\"mixed\", errors=\"coerce\")\n            weeks = t.groupby(m).nunique() if yoy and agg == \"sum\" and weekly_cadence(t) else None\n            return rows.assign(_m=m), agg, weeks\n\n        def series_of(rows: pd.DataFrame, col: str, agg: str, weeks):\n            \"\"\"Calendar-month values: a level's month-ends, a flow's totals (a rate's means); weekly\n            data: each month is its average week.\"\"\"\n            try:\n                out = aggregate(rows[rows[\"_m\"].notna()], [\"_m\"], col, agg, contract,\n                                over_time=True).sort_index()\n            except LevelUnavailable:   # a level without its account column: no built-in trend\n                return None\n            if weeks is not None:\n                out = out / weeks.reindex(out.index)\n                note = \"Weekly data: each month is compared as its average week (months have 4 or 5 week-endings).\"\n                if note not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n            return out.dropna()\n\n        for c in targets:\n            made = monthly(c)\n            if made is None:\n                continue\n            rows, agg, weeks = made\n            overall = series_of(rows, c, agg, weeks)\n            if overall is None or len(overall) < 2:\n                continue\n            # a measure that develops (losses at a valuation): a change between young accident\n            # months is development, not a trend; no built-in MoM / YoY, the note says why\n            if note := developing_trend(contract, df, c):\n                if (note := f\"{c}:{note}\") not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n                continue\n            # the data's own last month (before partial / run-out months were left out)\n            data_last = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\",\n                                       errors=\"coerce\").dt.to_period(\"M\").max()\n            # every segment compares the same months as the whole file (never its own last two,\n            # which can be a stale pair); a flow's month with no rows is 0\n            last = overall.index[-1]\n            # a first month the data covers only part of (invoices from 26 Sep) is no month to\n            # compare with: utils.cut_partial, the one rule (Domain 6 live run: '+109% YoY'\n            # against five days of September)\n            dated = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\", errors=\"coerce\")\n            kept, _ = cut_partial(overall, dated, \"M\")\n            partial_first = overall.index[0] if len(kept) and kept.index[0] != overall.index[0] else None\n            pairs = [(k, p_) for k, p_ in ((\"MoM\", overall.index[-2]), (\"YoY\", last - 12 if yoy else None))\n                     if p_ != partial_first]\n            jobs = [(None, overall, rows)]\n            if segs:   # the 10 largest groups, ties by name (the same on every machine)\n                for v in ranked(df[segs[0]].value_counts()).head(10).index:\n                    part = rows[rows[segs[0]] == v]\n                    series = series_of(part, c, agg, weeks)\n                    if series is not None and agg == \"sum\":\n                        series = series.reindex(overall.index, fill_value=0)\n                    jobs.append((str(v), series, part))\n            for seg, series, part in jobs:\n                if series is None:\n                    continue\n                tag = f\"trend:{c}\" + (f\" ({seg})\" if seg else \"\")\n                for period, then in pairs:\n                    if then is None or then not in series.index or last not in series.index:\n                        continue\n                    pct = pct_change(series[last], series[then])\n                    if pct is None:\n                        continue\n                    pct = round(float(pct), 2)   # the direction says the stated figure\n                    n = int(part.loc[part[\"_m\"].isin([last, then]), c].notna().sum())\n                    named = {\"latest\": str(last), \"previous\": str(then)} if last != data_last else {}\n                    raw[\"trends\"].append({\"column\": c, \"period\": period, \"pct_change\": pct,\n                                          \"segment\": seg, \"n\": n, **named,\n                                          \"direction\": \"up\" if pct > 0 else \"down\" if pct < 0 else \"flat\"})\n                    raw[\"builtin\"].append(f\"{tag}:{period}\")\n\n    if \"segmentation\" in types:\n        keys = [[x] for x in segs] + ([segs[:2]] if len(segs) >= 2 else [])\n        for c in targets:\n            rows, _ = rows_for(df, contract, c)\n            if c in level:   # a level by segment: each entity's latest row (a closed or stopped\n                cur = latest_rows(rows, c, contract)   # account is out), totals and means\n                for k in keys:\n                    s_ = \"|\".join(k)\n                    raw[\"segments\"] = [x for x in raw[\"segments\"] if not (\n                        isinstance(x, dict) and x.get(\"segment_column\") == s_ and x.get(\"metric_column\") == c\n                        and str(x.get(\"aggregation\") or \"sum\").lower() in (\"sum\", \"total\", \"last\", \"first\",\n                                                                             \"mean\", \"avg\", \"average\"))]\n                    for agg, vals in ((\"last\", cur.groupby(k)[c].sum(min_count=1).dropna()),\n                                      (\"mean\", cur.groupby(k)[c].mean().dropna())):\n                        raw[\"segments\"].append({\"segment_column\": s_, \"metric_column\": c, \"aggregation\": agg,\n                                                \"results\": [{\"name\": \"|\".join(map(str, n)) if isinstance(n, tuple)\n                                                             else str(n), \"value\": round(float(v), 4)}\n                                                            for n, v in vals.items()]})\n                    raw[\"builtin\"].append(f\"seg:{s_}/{c}\")\n            elif len(segs) >= 2:   # the joint breakdown fills a gap\n                joint = \"|\".join(segs[:2])\n                if any(isinstance(x, dict) and x.get(\"segment_column\") == joint and x.get(\"metric_column\") == c\n                       for x in raw[\"segments\"]):\n                    continue\n                means = rows.groupby(segs[:2])[c].mean()\n                top = ranked(rows.groupby(segs[:2]).size()).head(20).index\n                raw[\"segments\"].append({\"segment_column\": joint, \"metric_column\": c, \"aggregation\": \"mean\",\n                                        \"results\": [{\"name\": f\"{a}|{b}\", \"value\": round(float(means[(a, b)]), 4)}\n                                                    for a, b in top]})\n                raw[\"builtin\"].append(f\"seg:{joint}/{c}\")\n    _drop_protected_cells(raw, df, contract)\n", "result_excerpt": "{\"column\": \"Qty Ordered\", \"period\": \"MoM\", \"direction\": \"up\", \"pct_change\": 206.98, \"segment\": \"Backordered\"}", "row_count": 15, "confidence": "low", "confidence_reason": "only 15 rows", "assumptions": ["Qty Ordered by Status recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Shipped:MoM", "kind": "trend", "claim": "Qty Shipped MoM: -6.4%", "code": "# built-in statistics, computed in-process (agents/analysis_agent.standard_stats)\ndef standard_stats(raw: dict, df: pd.DataFrame, contract: DataContract, task: AnalysisTask) -> None:\n    \"\"\"Statistics with one right answer, computed in this process with the shared functions (plan\n    v2 R2: they were a second copy of the rules, as code text run in the sandbox, and drifted).\n    Merged into the sandbox's `raw` result as before: a target's MoM (and YoY on a pack's data)\n    replaces the model's; target-pair r and the joint breakdown fill gaps; a level by segment\n    replaces only the model's totals and means of it. Ids go to raw['builtin'] (evidence).\"\"\"\n    from agents.utils import (LevelUnavailable, aggregate, cut_partial, effective_agg, latest_rows, pct_change, ranked,\n                              time_axis, weekly_cadence)\n    from domain_pack import entity_rows, rows_for\n    types = {t.value if hasattr(t, \"value\") else t for t in task.analysis_types}\n    names = set(df.columns)\n    targets = [c for c in task.target_metrics if c in contract.metric_columns and c in names]\n    segs = [c for c in task.segments if c in names]\n    # a column's summary over the rows its tiles count (a claim's replaced and voided versions\n    # out, as every answer and chart): replaces the sandbox's every-row summary of that column\n    for c in (c for c in contract.metric_columns if c in names):\n        if (summary := counted_summary(df, contract, c)) is not None:\n            raw.setdefault(\"eda_summary\", {})[c] = summary\n    for key, empty in ((\"builtin\", []), (\"correlations\", {}), (\"trends\", []), (\"segments\", []),\n                       (\"assumptions\", [])):\n        raw.setdefault(key, empty)\n    level = {c.name for c in contract.columns if c.aggregation in (\"last\", \"first\")}\n\n    if types & {\"correlation\", \"hypothesis\"}:   # snapshot data: one row per entity\n        cdf = entity_rows(df, contract)\n        for i, a in enumerate(targets):\n            for b in targets[i + 1:]:\n                if f\"{a}__{b}\" in raw[\"correlations\"] or f\"{b}__{a}\" in raw[\"correlations\"]:\n                    continue\n                r = pd.to_numeric(cdf[a], errors=\"coerce\").corr(pd.to_numeric(cdf[b], errors=\"coerce\"))\n                if r == r:\n                    raw[\"correlations\"][f\"{a}__{b}\"] = round(float(r), 4)\n                    raw[\"builtin\"].append(f\"corr:{a}__{b}\")\n\n    yoy = defaults_pack(contract) is not None\n    if types & {\"trend\", \"forecasting\"} and targets:\n        replaced = (\"MoM\", \"YoY\") if yoy else (\"MoM\",)\n        raw[\"trends\"] = [t for t in raw[\"trends\"] if not (isinstance(t, dict) and t.get(\"period\")\n                         in replaced and t.get(\"column\") in targets)]\n\n        def monthly(col: str):\n            \"\"\"(rows, their month, how a month is made) for `col`, judged once on the whole file:\n            the rows its tiles count, the main currency and a mid-month export's partial last\n            month (a segment's slice never re-judges them).\"\"\"\n            date = time_axis(contract, col, df)\n            agg = effective_agg(contract, col, None) or (\n                \"mean\" if pd.to_numeric(df[col], errors=\"coerce\").dropna().between(0, 1).all() else \"sum\")\n            if not date or (agg in (\"last\", \"first\") and col not in level):\n                return None\n            rows, m = counted_months(df, contract, col, date)\n            t = pd.to_datetime(rows[date], format=\"mixed\", errors=\"coerce\")\n            weeks = t.groupby(m).nunique() if yoy and agg == \"sum\" and weekly_cadence(t) else None\n            return rows.assign(_m=m), agg, weeks\n\n        def series_of(rows: pd.DataFrame, col: str, agg: str, weeks):\n            \"\"\"Calendar-month values: a level's month-ends, a flow's totals (a rate's means); weekly\n            data: each month is its average week.\"\"\"\n            try:\n                out = aggregate(rows[rows[\"_m\"].notna()], [\"_m\"], col, agg, contract,\n                                over_time=True).sort_index()\n            except LevelUnavailable:   # a level without its account column: no built-in trend\n                return None\n            if weeks is not None:\n                out = out / weeks.reindex(out.index)\n                note = \"Weekly data: each month is compared as its average week (months have 4 or 5 week-endings).\"\n                if note not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n            return out.dropna()\n\n        for c in targets:\n            made = monthly(c)\n            if made is None:\n                continue\n            rows, agg, weeks = made\n            overall = series_of(rows, c, agg, weeks)\n            if overall is None or len(overall) < 2:\n                continue\n            # a measure that develops (losses at a valuation): a change between young accident\n            # months is development, not a trend; no built-in MoM / YoY, the note says why\n            if note := developing_trend(contract, df, c):\n                if (note := f\"{c}:{note}\") not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n                continue\n            # the data's own last month (before partial / run-out months were left out)\n            data_last = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\",\n                                       errors=\"coerce\").dt.to_period(\"M\").max()\n            # every segment compares the same months as the whole file (never its own last two,\n            # which can be a stale pair); a flow's month with no rows is 0\n            last = overall.index[-1]\n            # a first month the data covers only part of (invoices from 26 Sep) is no month to\n            # compare with: utils.cut_partial, the one rule (Domain 6 live run: '+109% YoY'\n            # against five days of September)\n            dated = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\", errors=\"coerce\")\n            kept, _ = cut_partial(overall, dated, \"M\")\n            partial_first = overall.index[0] if len(kept) and kept.index[0] != overall.index[0] else None\n            pairs = [(k, p_) for k, p_ in ((\"MoM\", overall.index[-2]), (\"YoY\", last - 12 if yoy else None))\n                     if p_ != partial_first]\n            jobs = [(None, overall, rows)]\n            if segs:   # the 10 largest groups, ties by name (the same on every machine)\n                for v in ranked(df[segs[0]].value_counts()).head(10).index:\n                    part = rows[rows[segs[0]] == v]\n                    series = series_of(part, c, agg, weeks)\n                    if series is not None and agg == \"sum\":\n                        series = series.reindex(overall.index, fill_value=0)\n                    jobs.append((str(v), series, part))\n            for seg, series, part in jobs:\n                if series is None:\n                    continue\n                tag = f\"trend:{c}\" + (f\" ({seg})\" if seg else \"\")\n                for period, then in pairs:\n                    if then is None or then not in series.index or last not in series.index:\n                        continue\n                    pct = pct_change(series[last], series[then])\n                    if pct is None:\n                        continue\n                    pct = round(float(pct), 2)   # the direction says the stated figure\n                    n = int(part.loc[part[\"_m\"].isin([last, then]), c].notna().sum())\n                    named = {\"latest\": str(last), \"previous\": str(then)} if last != data_last else {}\n                    raw[\"trends\"].append({\"column\": c, \"period\": period, \"pct_change\": pct,\n                                          \"segment\": seg, \"n\": n, **named,\n                                          \"direction\": \"up\" if pct > 0 else \"down\" if pct < 0 else \"flat\"})\n                    raw[\"builtin\"].append(f\"{tag}:{period}\")\n\n    if \"segmentation\" in types:\n        keys = [[x] for x in segs] + ([segs[:2]] if len(segs) >= 2 else [])\n        for c in targets:\n            rows, _ = rows_for(df, contract, c)\n            if c in level:   # a level by segment: each entity's latest row (a closed or stopped\n                cur = latest_rows(rows, c, contract)   # account is out), totals and means\n                for k in keys:\n                    s_ = \"|\".join(k)\n                    raw[\"segments\"] = [x for x in raw[\"segments\"] if not (\n                        isinstance(x, dict) and x.get(\"segment_column\") == s_ and x.get(\"metric_column\") == c\n                        and str(x.get(\"aggregation\") or \"sum\").lower() in (\"sum\", \"total\", \"last\", \"first\",\n                                                                             \"mean\", \"avg\", \"average\"))]\n                    for agg, vals in ((\"last\", cur.groupby(k)[c].sum(min_count=1).dropna()),\n                                      (\"mean\", cur.groupby(k)[c].mean().dropna())):\n                        raw[\"segments\"].append({\"segment_column\": s_, \"metric_column\": c, \"aggregation\": agg,\n                                                \"results\": [{\"name\": \"|\".join(map(str, n)) if isinstance(n, tuple)\n                                                             else str(n), \"value\": round(float(v), 4)}\n                                                            for n, v in vals.items()]})\n                    raw[\"builtin\"].append(f\"seg:{s_}/{c}\")\n            elif len(segs) >= 2:   # the joint breakdown fills a gap\n                joint = \"|\".join(segs[:2])\n                if any(isinstance(x, dict) and x.get(\"segment_column\") == joint and x.get(\"metric_column\") == c\n                       for x in raw[\"segments\"]):\n                    continue\n                means = rows.groupby(segs[:2])[c].mean()\n                top = ranked(rows.groupby(segs[:2]).size()).head(20).index\n                raw[\"segments\"].append({\"segment_column\": joint, \"metric_column\": c, \"aggregation\": \"mean\",\n                                        \"results\": [{\"name\": f\"{a}|{b}\", \"value\": round(float(means[(a, b)]), 4)}\n                                                    for a, b in top]})\n                raw[\"builtin\"].append(f\"seg:{joint}/{c}\")\n    _drop_protected_cells(raw, df, contract)\n", "result_excerpt": "{\"column\": \"Qty Shipped\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -6.37, \"segment\": null}", "row_count": 1511, "confidence": "high", "confidence_reason": "1511 rows", "assumptions": ["Qty Shipped 7d_rolling: computed by the model's own code, not by the built-in rule the figures use (Only the rows the figures count: 110 other rows left out)", "Qty Shipped by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Warehouse recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Carrier recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "trend:Qty Shipped (Delivered):MoM", "kind": "trend", "claim": "Qty Shipped (Delivered) MoM: -16.1%", "code": "# built-in statistics, computed in-process (agents/analysis_agent.standard_stats)\ndef standard_stats(raw: dict, df: pd.DataFrame, contract: DataContract, task: AnalysisTask) -> None:\n    \"\"\"Statistics with one right answer, computed in this process with the shared functions (plan\n    v2 R2: they were a second copy of the rules, as code text run in the sandbox, and drifted).\n    Merged into the sandbox's `raw` result as before: a target's MoM (and YoY on a pack's data)\n    replaces the model's; target-pair r and the joint breakdown fill gaps; a level by segment\n    replaces only the model's totals and means of it. Ids go to raw['builtin'] (evidence).\"\"\"\n    from agents.utils import (LevelUnavailable, aggregate, cut_partial, effective_agg, latest_rows, pct_change, ranked,\n                              time_axis, weekly_cadence)\n    from domain_pack import entity_rows, rows_for\n    types = {t.value if hasattr(t, \"value\") else t for t in task.analysis_types}\n    names = set(df.columns)\n    targets = [c for c in task.target_metrics if c in contract.metric_columns and c in names]\n    segs = [c for c in task.segments if c in names]\n    # a column's summary over the rows its tiles count (a claim's replaced and voided versions\n    # out, as every answer and chart): replaces the sandbox's every-row summary of that column\n    for c in (c for c in contract.metric_columns if c in names):\n        if (summary := counted_summary(df, contract, c)) is not None:\n            raw.setdefault(\"eda_summary\", {})[c] = summary\n    for key, empty in ((\"builtin\", []), (\"correlations\", {}), (\"trends\", []), (\"segments\", []),\n                       (\"assumptions\", [])):\n        raw.setdefault(key, empty)\n    level = {c.name for c in contract.columns if c.aggregation in (\"last\", \"first\")}\n\n    if types & {\"correlation\", \"hypothesis\"}:   # snapshot data: one row per entity\n        cdf = entity_rows(df, contract)\n        for i, a in enumerate(targets):\n            for b in targets[i + 1:]:\n                if f\"{a}__{b}\" in raw[\"correlations\"] or f\"{b}__{a}\" in raw[\"correlations\"]:\n                    continue\n                r = pd.to_numeric(cdf[a], errors=\"coerce\").corr(pd.to_numeric(cdf[b], errors=\"coerce\"))\n                if r == r:\n                    raw[\"correlations\"][f\"{a}__{b}\"] = round(float(r), 4)\n                    raw[\"builtin\"].append(f\"corr:{a}__{b}\")\n\n    yoy = defaults_pack(contract) is not None\n    if types & {\"trend\", \"forecasting\"} and targets:\n        replaced = (\"MoM\", \"YoY\") if yoy else (\"MoM\",)\n        raw[\"trends\"] = [t for t in raw[\"trends\"] if not (isinstance(t, dict) and t.get(\"period\")\n                         in replaced and t.get(\"column\") in targets)]\n\n        def monthly(col: str):\n            \"\"\"(rows, their month, how a month is made) for `col`, judged once on the whole file:\n            the rows its tiles count, the main currency and a mid-month export's partial last\n            month (a segment's slice never re-judges them).\"\"\"\n            date = time_axis(contract, col, df)\n            agg = effective_agg(contract, col, None) or (\n                \"mean\" if pd.to_numeric(df[col], errors=\"coerce\").dropna().between(0, 1).all() else \"sum\")\n            if not date or (agg in (\"last\", \"first\") and col not in level):\n                return None\n            rows, m = counted_months(df, contract, col, date)\n            t = pd.to_datetime(rows[date], format=\"mixed\", errors=\"coerce\")\n            weeks = t.groupby(m).nunique() if yoy and agg == \"sum\" and weekly_cadence(t) else None\n            return rows.assign(_m=m), agg, weeks\n\n        def series_of(rows: pd.DataFrame, col: str, agg: str, weeks):\n            \"\"\"Calendar-month values: a level's month-ends, a flow's totals (a rate's means); weekly\n            data: each month is its average week.\"\"\"\n            try:\n                out = aggregate(rows[rows[\"_m\"].notna()], [\"_m\"], col, agg, contract,\n                                over_time=True).sort_index()\n            except LevelUnavailable:   # a level without its account column: no built-in trend\n                return None\n            if weeks is not None:\n                out = out / weeks.reindex(out.index)\n                note = \"Weekly data: each month is compared as its average week (months have 4 or 5 week-endings).\"\n                if note not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n            return out.dropna()\n\n        for c in targets:\n            made = monthly(c)\n            if made is None:\n                continue\n            rows, agg, weeks = made\n            overall = series_of(rows, c, agg, weeks)\n            if overall is None or len(overall) < 2:\n                continue\n            # a measure that develops (losses at a valuation): a change between young accident\n            # months is development, not a trend; no built-in MoM / YoY, the note says why\n            if note := developing_trend(contract, df, c):\n                if (note := f\"{c}:{note}\") not in raw[\"assumptions\"]:\n                    raw[\"assumptions\"].append(note)\n                continue\n            # the data's own last month (before partial / run-out months were left out)\n            data_last = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\",\n                                       errors=\"coerce\").dt.to_period(\"M\").max()\n            # every segment compares the same months as the whole file (never its own last two,\n            # which can be a stale pair); a flow's month with no rows is 0\n            last = overall.index[-1]\n            # a first month the data covers only part of (invoices from 26 Sep) is no month to\n            # compare with: utils.cut_partial, the one rule (Domain 6 live run: '+109% YoY'\n            # against five days of September)\n            dated = pd.to_datetime(rows[time_axis(contract, c, df)], format=\"mixed\", errors=\"coerce\")\n            kept, _ = cut_partial(overall, dated, \"M\")\n            partial_first = overall.index[0] if len(kept) and kept.index[0] != overall.index[0] else None\n            pairs = [(k, p_) for k, p_ in ((\"MoM\", overall.index[-2]), (\"YoY\", last - 12 if yoy else None))\n                     if p_ != partial_first]\n            jobs = [(None, overall, rows)]\n            if segs:   # the 10 largest groups, ties by name (the same on every machine)\n                for v in ranked(df[segs[0]].value_counts()).head(10).index:\n                    part = rows[rows[segs[0]] == v]\n                    series = series_of(part, c, agg, weeks)\n                    if series is not None and agg == \"sum\":\n                        series = series.reindex(overall.index, fill_value=0)\n                    jobs.append((str(v), series, part))\n            for seg, series, part in jobs:\n                if series is None:\n                    continue\n                tag = f\"trend:{c}\" + (f\" ({seg})\" if seg else \"\")\n                for period, then in pairs:\n                    if then is None or then not in series.index or last not in series.index:\n                        continue\n                    pct = pct_change(series[last], series[then])\n                    if pct is None:\n                        continue\n                    pct = round(float(pct), 2)   # the direction says the stated figure\n                    n = int(part.loc[part[\"_m\"].isin([last, then]), c].notna().sum())\n                    named = {\"latest\": str(last), \"previous\": str(then)} if last != data_last else {}\n                    raw[\"trends\"].append({\"column\": c, \"period\": period, \"pct_change\": pct,\n                                          \"segment\": seg, \"n\": n, **named,\n                                          \"direction\": \"up\" if pct > 0 else \"down\" if pct < 0 else \"flat\"})\n                    raw[\"builtin\"].append(f\"{tag}:{period}\")\n\n    if \"segmentation\" in types:\n        keys = [[x] for x in segs] + ([segs[:2]] if len(segs) >= 2 else [])\n        for c in targets:\n            rows, _ = rows_for(df, contract, c)\n            if c in level:   # a level by segment: each entity's latest row (a closed or stopped\n                cur = latest_rows(rows, c, contract)   # account is out), totals and means\n                for k in keys:\n                    s_ = \"|\".join(k)\n                    raw[\"segments\"] = [x for x in raw[\"segments\"] if not (\n                        isinstance(x, dict) and x.get(\"segment_column\") == s_ and x.get(\"metric_column\") == c\n                        and str(x.get(\"aggregation\") or \"sum\").lower() in (\"sum\", \"total\", \"last\", \"first\",\n                                                                             \"mean\", \"avg\", \"average\"))]\n                    for agg, vals in ((\"last\", cur.groupby(k)[c].sum(min_count=1).dropna()),\n                                      (\"mean\", cur.groupby(k)[c].mean().dropna())):\n                        raw[\"segments\"].append({\"segment_column\": s_, \"metric_column\": c, \"aggregation\": agg,\n                                                \"results\": [{\"name\": \"|\".join(map(str, n)) if isinstance(n, tuple)\n                                                             else str(n), \"value\": round(float(v), 4)}\n                                                            for n, v in vals.items()]})\n                    raw[\"builtin\"].append(f\"seg:{s_}/{c}\")\n            elif len(segs) >= 2:   # the joint breakdown fills a gap\n                joint = \"|\".join(segs[:2])\n                if any(isinstance(x, dict) and x.get(\"segment_column\") == joint and x.get(\"metric_column\") == c\n                       for x in raw[\"segments\"]):\n                    continue\n                means = rows.groupby(segs[:2])[c].mean()\n                top = ranked(rows.groupby(segs[:2]).size()).head(20).index\n                raw[\"segments\"].append({\"segment_column\": joint, \"metric_column\": c, \"aggregation\": \"mean\",\n                                        \"results\": [{\"name\": f\"{a}|{b}\", \"value\": round(float(means[(a, b)]), 4)}\n                                                    for a, b in top]})\n                raw[\"builtin\"].append(f\"seg:{joint}/{c}\")\n    _drop_protected_cells(raw, df, contract)\n", "result_excerpt": "{\"column\": \"Qty Shipped\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -16.13, \"segment\": \"Delivered\"}", "row_count": 1319, "confidence": "high", "confidence_reason": "1319 rows", "assumptions": ["Qty Shipped 7d_rolling: computed by the model's own code, not by the built-in rule the figures use (Only the rows the figures count: 110 other rows left out)", "Qty Shipped by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Warehouse recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Carrier recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "seg:Status/Qty Ordered:sum", "kind": "segment", "claim": "sum Qty Ordered by Status (4 groups)", "code": "try:\n    sale_df = df[df['row_kind'] == 'sale'].copy()\nexcept Exception:\n    sale_df = df.copy()\n\n# EDA\ntry:\n    metric_cols = ['Qty Ordered', 'Qty Shipped']\n    eda = {}\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        eda[col] = {\n            \"mean\": float(s.mean()),\n            \"std\": float(s.std()),\n            \"min\": float(s.min()),\n            \"max\": float(s.max()),\n            \"median\": float(s.median()),\n            \"count\": int(s.count())\n        }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# CORRELATIONS\ntry:\n    num_cols = sale_df[metric_cols].dropna()\n    corr_dict = {}\n    for i, c1 in enumerate(metric_cols):\n        for c2 in metric_cols[i+1:]:\n            pair = num_cols[[c1, c2]].dropna()\n            if len(pair) > 1:\n                r = float(pair[c1].corr(pair[c2]))\n                if abs(r) >= 0.2:\n                    corr_dict[f\"{c1}__{c2}\"] = round(r, 4)\n    result['correlations'] = corr_dict\nexcept Exception:\n    pass\n\n# SEGMENTATION\ntry:\n    seg_results = []\n    segment_cols = ['Status', 'Warehouse', 'Carrier']\n    for seg in segment_cols:\n        for metric in metric_cols:\n            grp = sale_df.groupby(seg)[metric].sum().nlargest(10)\n            seg_results.append({\n                \"segment_column\": seg,\n                \"metric_column\": metric,\n                \"aggregation\": \"sum\",\n                \"label\": None,\n                \"results\": [{\"name\": str(k), \"value\": float(v)} for k, v in grp.items()]\n            })\n\n    # Unit fill rate by Warehouse\n    judged_statuses = ['delivered', 'backordered', 'returned', 'short shipped', 'partially shipped', 'shipped']\n    judged = sale_df[~sale_df['Status'].str.lower().isin(['open','pending','allocated','released','picked','packed'])]\n    for seg in ['Warehouse', 'Carrier']:\n        grp_num = judged.groupby(seg)['Qty Shipped'].sum()\n        grp_den = judged.groupby(seg)['Qty Ordered'].sum()\n        ratio = (grp_num / grp_den).dropna().nlargest(10)\n        seg_results.append({\n            \"segment_column\": seg,\n            \"metric_column\": \"Qty Shipped\",\n            \"aggregation\": \"ratio\",\n            \"label\": \"unit_fill\",\n            \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in ratio.items()]\n        })\n\n    # Line fill rate by Status\n    judged2 = judged.copy()\n    judged2['_full'] = judged2['shipped_minus_ordered'] >= 0\n    line_fill_num = judged2.groupby('Status')['_full'].sum()\n    line_fill_den = judged2.groupby('Status')['Order Line ID'].nunique()\n    line_fill = (line_fill_num / line_fill_den).dropna().nlargest(10)\n    seg_results.append({\n        \"segment_column\": \"Status\",\n        \"metric_column\": \"Order Line ID\",\n        \"aggregation\": \"ratio\",\n        \"label\": \"line_fill\",\n        \"results\": [{\"name\": str(k), \"value\": round(float(v), 4)} for k, v in line_fill.items()]\n    })\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# ANOMALIES\ntry:\n    anomalies = []\n    import numpy as np\n    for col in metric_cols:\n        s = sale_df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if s.min() < 0:\n            shift = -s.min()\n        if abs(skew) > 2:\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1 = s_t.quantile(0.25)\n        q3 = s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        flagged = s_t[(s_t < lo) | (s_t > hi)]\n        if len(flagged) / len(s_t) > 0.05:\n            anomalies.append({\n                \"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\",\n                \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually\"\n            })\n            continue\n        lo_orig = float(np.expm1(lo) - shift) if abs(skew) > 2 else float(lo)\n        hi_orig = float(np.expm1(hi) - shift) if abs(skew) > 2 else float(hi)\n        lo4 = q1 - 4 * iqr; hi4 = q3 + 4 * iqr\n        lo5 = q1 - 5 * iqr; hi5 = q3 + 5 * iqr\n        for idx in flagged.index:\n            if len(anomalies) >= 25:\n                break\n            raw_val = float(s.loc[idx])\n            tv = float(s_t.loc[idx])\n            if tv < lo5 or tv > hi5:\n                sev = \"critical\"\n            elif tv < lo4 or tv > hi4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            exp_range = f\"[{lo_orig:.1f}, {hi_orig:.1f}]\"\n            anomalies.append({\n                \"column\": col,\n                \"row_index\": int(idx),\n                \"value\": raw_val,\n                \"expected_range\": exp_range,\n                \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val} lies outside expected range {exp_range}\"\n            })\n    result['anomalies'] = anomalies\nexcept Exception:\n    pass\n\n# TRENDS\ntry:\n    import pandas as pd\n    trends = []\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    sale_df['_ym'] = sale_df['_order_date'].dt.to_period('M')\n    for metric in metric_cols:\n        monthly = sale_df.groupby('_ym')[metric].sum().sort_index()\n        if len(monthly) >= 2:\n            pct = float((monthly.iloc[-1] - monthly.iloc[-2]) / monthly.iloc[-2] * 100) if monthly.iloc[-2] != 0 else 0.0\n            direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n            trends.append({\n                \"column\": metric,\n                \"period\": \"MoM\",\n                \"direction\": direction,\n                \"pct_change\": round(pct, 2),\n                \"segment\": None\n            })\n    # 7d rolling trend on Qty Shipped\n    daily = sale_df.groupby(sale_df['_order_date'].dt.date)['Qty Shipped'].sum().reset_index()\n    daily.columns = ['date', 'qty']\n    daily = daily.sort_values('date')\n    if len(daily) >= 14:\n        roll = daily['qty'].rolling(7).mean()\n        last7 = float(roll.iloc[-1])\n        prev7 = float(roll.iloc[-8]) if len(roll) >= 8 else float(roll.iloc[0])\n        pct7 = (last7 - prev7) / prev7 * 100 if prev7 != 0 else 0.0\n        direction7 = \"up\" if pct7 > 1 else (\"down\" if pct7 < -1 else \"flat\")\n        trends.append({\n            \"column\": \"Qty Shipped\",\n            \"period\": \"7d_rolling\",\n            \"direction\": direction7,\n            \"pct_change\": round(float(pct7), 2),\n            \"segment\": None\n        })\n    result['trends'] = trends\nexcept Exception:\n    pass\n\n# FORECASTING (simple linear extrapolation on monthly Qty Shipped)\ntry:\n    import numpy as np\n    import pandas as pd\n    sale_df['_order_date'] = pd.to_datetime(sale_df['Order Date'])\n    monthly_ship = sale_df.groupby(sale_df['_order_date'].dt.to_period('M'))['Qty Shipped'].sum().sort_index()\n    if len(monthly_ship) >= 3:\n        x = np.arange(len(monthly_ship))\n        y = monthly_ship.values.astype(float)\n        coeffs = np.polyfit(x, y, 1)\n        next_x = len(monthly_ship)\n        next_val = float(np.polyval(coeffs, next_x))\n        next_period = str(monthly_ship.index[-1] + 1)\n        result['forecast_points'] = [{\"period\": next_period, \"value\": round(next_val, 2)}]\nexcept Exception:\n    pass\n\n# ASSUMPTIONS\nresult['assumptions'] = [\n    \"Only 'sale' rows (row_kind='sale') are used for all KPIs and segmentation.\",\n    \"Unit fill and line fill exclude open/pending/allocated/released/picked/packed lines.\",\n    \"Correlations are Pearson r; only |r| >= 0.2 reported.\",\n    \"Anomaly IQR uses 3x boundary; columns flagging >5% of rows treated as heavy-tailed.\",\n    \"Forecast is a linear extrapolation of monthly Qty Shipped totals \u2014 indicative only.\"\n]", "result_excerpt": "{\"segment_column\": \"Status\", \"metric_column\": \"Qty Ordered\", \"aggregation\": \"sum\", \"results\": [{\"name\": \"Delivered\", \"value\": 138983.0}, {\"name\": \"Open\", \"value\": 2705.0}, {\"name\": \"Shipped\", \"value\": 1681.0}, {\"name\": \"Backordered\", \"value\": 773.0}]}", "row_count": 6025, "confidence": "high", "confidence_reason": "6025 rows", "assumptions": ["Qty Ordered by Status recomputed: Only the rows the figures count: 110 other rows left out.", "Qty Shipped by Status recomputed: Only the rows the figures count: 110 other rows left out."]}, {"id": "seg:Status/Qty Shipped:sum", "kind": "segment", "claim": "sum Qty Shipped by Status (4 groups)", "code": "try:\n    sale_df = df[df['row_kind'] == 'sale'].copy()\nexcept Exception:\n    sale_df = df.copy()\n\n# EDA\ntry:\n    metric_cols = ['Qty Ordered', 'Qty Shipped']\n    eda = {}\n    for col 