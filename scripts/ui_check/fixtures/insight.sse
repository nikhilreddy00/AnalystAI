data: {"type": "briefing", "data": {"head_preview": [{"order_id": 100917, "order_date": "2025-11-01", "segment": "A", "region": "North", "revenue": 77.47, "units": 8, "discount": 0.045, "marketing_spend": 30.67, "customer_email": "user626@example.com", "customer_name": "Ivo Park", "notes": ""}, {"order_id": 101934, "order_date": "2025-11-01", "segment": "A", "region": "North", "revenue": 88.16, "units": 1, "discount": 0.087, "marketing_spend": 34.69, "customer_email": "user28@example.com", "customer_name": "Dara Moss", "notes": ""}, {"order_id": 102418, "order_date": "2025-11-01", "segment": "B", "region": "East", "revenue": 65.86, "units": 5, "discount": 0.148, "marketing_spend": 26.21, "customer_email": "user446@example.com", "customer_name": "Ivo Moss", "notes": ""}, {"order_id": 102659, "order_date": "2025-11-01", "segment": "A", "region": "West", "revenue": 99.07, "units": 3, "discount": 0.061, "marketing_spend": 24.33, "customer_email": "user820@example.com", "customer_name": "Eli Moss", "notes": ""}, {"order_id": 102675, "order_date": "2025-11-01", "segment": "A", "region": "East", "revenue": 101.33, "units": 3, "discount": 0.078, "marketing_spend": 31.45, "customer_email": "user775@example.com", "customer_name": "Fay Novak", "notes": ""}], "dtypes_summary": {"order_id": "int64", "order_date": "str", "segment": "str", "region": "str", "revenue": "float64", "units": "int64", "discount": "float64", "marketing_spend": "float64", "customer_email": "str", "customer_name": "str", "notes": "str"}, "missing_pct": {"order_id": 0.0, "order_date": 0.0, "segment": 0.0, "region": 0.0, "revenue": 0.0, "units": 0.0, "discount": 0.0, "marketing_spend": 0.0, "customer_email": 0.0, "customer_name": 0.0, "notes": 0.0}, "describe_stats": {"order_id": {"count": 3025.0, "mean": 101498.3523966942, "std": 866.7111333116, "min": 100000.0, "25%": 100748.0, "50%": 101498.0, "75%": 102247.0, "max": 102999.0}, "revenue": {"count": 3025.0, "mean": 102.8164528926, "std": 42.1565136541, "min": 21.47, "25%": 79.18, "50%": 100.39, "75%": 124.58, "max": 964.19}, "units": {"count": 3025.0, "mean": 4.4323966942, "std": 2.2908855179, "min": 1.0, "25%": 2.0, "50%": 4.0, "75%": 6.0, "max": 8.0}, "discount": {"count": 3025.0, "mean": 0.1476790083, "std": 0.0873323173, "min": 0.0, "25%": 0.072, "50%": 0.147, "75%": 0.225, "max": 0.3}, "marketing_spend": {"count": 3025.0, "mean": 49.6276694215, "std": 18.525425454, "min": 12.62, "25%": 32.9, "50%": 48.98, "75%": 66.87, "max": 90.32}}, "kpis": [{"label": "Total Orders", "value": "3,025", "context": "3,025 order records", "recipe": {"kind": "row_count", "column": null, "target_column": null, "segment_column": null, "format_kind": null}, "how": "Count of all 3,025 rows after cleaning."}, {"label": "Avg Revenue", "value": "$102.82", "context": "Range $21.47 \u2013 $964.19", "recipe": {"kind": "metric_avg", "column": "revenue", "target_column": null, "segment_column": null, "format_kind": "currency"}, "how": "Mean of revenue over its non-missing rows."}, {"label": "Top Segment", "value": "A", "context": "40.6% of orders", "recipe": {"kind": "top_cat", "column": "segment", "target_column": null, "segment_column": null, "format_kind": null}, "how": "Most frequent value of segment, and its share of rows."}, {"label": "Discount Variability", "value": "CV 0.59", "context": "Mean 14.8% \u00b1 8.7%", "recipe": {"kind": "highest_cv", "column": "discount", "target_column": null, "segment_column": null, "format_kind": "percent"}, "how": "Coefficient of variation (std / |mean|) of discount, the most variable measure."}], "unique_counts": {"order_id": 3000, "order_date": 365, "segment": 3, "region": 4, "revenue": 2662, "units": 8, "discount": 301, "marketing_spend": 2370, "customer_email": 874, "customer_name": 80, "notes": 2}, "sample_values_per_col": {"order_id": [100917, 101934, 102418], "order_date": ["2025-11-01", "2025-11-01", "2025-11-01"], "segment": ["A", "A", "B"], "region": ["North", "North", "East"], "revenue": [77.47, 88.16, 65.86], "units": [8, 1, 5], "discount": [0.045, 0.087, 0.148], "marketing_spend": [30.67, 34.69, 26.21], "customer_email": ["user626@example.com", "user28@example.com", "user446@example.com"], "customer_name": ["Ivo Park", "Dara Moss", "Ivo Moss"], "notes": ["", "", ""]}, "skewness": {"order_id": 0.001, "revenue": 8.269, "units": 0.034, "discount": 0.032, "marketing_spend": 0.03}, "target_col": null, "target_correlations": {}, "column_roles_summary": {"order_id": "id_cols", "notes": "binary_cols", "segment": "low_card_cat", "region": "low_card_cat", "units": "low_card_cat", "revenue": "continuous", "discount": "continuous", "marketing_spend": "continuous", "order_date": "datetime_cols", "customer_email": "skip_cols", "customer_name": "skip_cols"}}}

data: {"type": "evidence", "data": [{"id": "clean:audit", "kind": "cleaning", "claim": "Cleaning: 3025 \u2192 3000 rows, 2 logged changes", "code": "# cleaning rules-v1\ndrop_duplicates('*', exact)\nkeep('notes', high_null)", "result_excerpt": "{\"rows_before\": 3025, \"rows_after\": 3000, \"decisions\": [[\"*\", \"drop_duplicates\", 25, 25], [\"notes\", \"keep\", 0, 0]]}", "row_count": 3000, "confidence": "medium", "confidence_reason": "many missing or unreadable values in notes", "assumptions": ["*: Removed 25 exact duplicate rows (same order_id and every other value).", "notes: 2999 of 3000 values missing (>99.9%): too empty to use with confidence; left as missing."]}, {"id": "corr:revenue__marketing_spend", "kind": "correlation", "claim": "revenue and marketing_spend: r = 0.569", "code": "# EDA\ntry:\n    for col in ['revenue', 'units', 'discount', 'marketing_spend']:\n        s = df[col].dropna()\n        result['eda_summary'][col] = {\n            'mean': float(s.mean()), 'std': float(s.std()),\n            'min': float(s.min()), 'max': float(s.max()),\n            'median': float(s.median()), 'count': int(s.count())\n        }\nexcept Exception:\n    pass\n\n# CORRELATIONS\ntry:\n    num_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    corr_matrix = df[num_cols].corr(method='pearson')\n    for i, c1 in enumerate(num_cols):\n        for c2 in num_cols[i+1:]:\n            r = corr_matrix.loc[c1, c2]\n            if abs(r) >= 0.2:\n                result['correlations'][f'{c1}__{c2}'] = round(float(r), 4)\nexcept Exception:\n    pass\n\n# SEGMENTATION\ntry:\n    seg_cols = ['segment', 'region']\n    metric_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    for seg in seg_cols:\n        top_groups = df[seg].value_counts().head(10).index\n        sub = df[df[seg].isin(top_groups)]\n        for metric in metric_cols:\n            grp = sub.groupby(seg)[metric].mean()\n            result['segments'].append({\n                'segment_column': seg, 'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': str(k), 'value': round(float(v), 4)} for k, v in grp.items()]\n            })\n        cnt = sub.groupby(seg)['revenue'].count()\n        result['segments'].append({\n            'segment_column': seg, 'metric_column': 'revenue',\n            'aggregation': 'count',\n            'results': [{'name': str(k), 'value': int(v)} for k, v in cnt.items()]\n        })\n    # Joint breakdown segment x region\n    top_seg = df['segment'].value_counts().head(5).index\n    top_reg = df['region'].value_counts().head(5).index\n    sub2 = df[df['segment'].isin(top_seg) & df['region'].isin(top_reg)].copy()\n    sub2['_key'] = sub2['segment'].astype(str) + '|' + sub2['region'].astype(str)\n    for metric in ['revenue', 'units']:\n        grp2 = sub2.groupby('_key')[metric].mean().nlargest(10)\n        result['segments'].append({\n            'segment_column': 'segment|region', 'metric_column': metric,\n            'aggregation': 'mean',\n            'results': [{'name': str(k), 'value': round(float(v), 4)} for k, v in grp2.items()]\n        })\nexcept Exception:\n    pass\n\n# ANOMALIES\ntry:\n    import numpy as np\n    anomaly_records = []\n    for col in ['revenue', 'units', 'discount', 'marketing_spend']:\n        s = df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        if abs(skew) > 2:\n            shift = max(0, -s.min()) + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n            shift = 0\n        Q1, Q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        IQR = Q3 - Q1\n        lo3, hi3 = Q1 - 3*IQR, Q3 + 3*IQR\n        lo4, hi4 = Q1 - 4*IQR, Q3 + 4*IQR\n        lo5, hi5 = Q1 - 5*IQR, Q3 + 5*IQR\n        mask = (s_t < lo3) | (s_t > hi3)\n        if mask.sum() / len(s) > 0.05:\n            anomaly_records.append({\n                'column': col, 'row_index': None, 'value': None,\n                'expected_range': f'[{float(s.quantile(0.25)):.4g}, {float(s.quantile(0.75)):.4g}]',\n                'severity': 'low',\n                'explanation': f'{col} is heavy-tailed; extreme-value flagging skipped'\n            })\n            continue\n        flagged = df.loc[s_t[mask].index, col]\n        orig_lo = float(np.expm1(lo3) - shift) if abs(skew) > 2 else float(Q1 - 3*IQR)\n        orig_hi = float(np.expm1(hi3) - shift) if abs(skew) > 2 else float(Q3 + 3*IQR)\n        exp_range = f'[{orig_lo:.4g}, {orig_hi:.4g}]'\n        for idx, val in flagged.items():\n            tv = s_t[idx]\n            if tv > hi5 or tv < lo5:\n                sev = 'critical'\n            elif tv > hi4 or tv < lo4:\n                sev = 'high'\n            else:\n                sev = 'medium'\n            anomaly_records.append({\n                'column': col, 'row_index': int(idx), 'value': float(val),\n                'expected_range': exp_range, 'severity': sev,\n                'explanation': f'{col} value {float(val):.4g} lies outside expected range {exp_range}'\n            })\n    anomaly_records.sort(key=lambda x: ['low','medium','high','critical'].index(x['severity']), reverse=True)\n    result['anomalies'] = anomaly_records[:25]\nexcept Exception:\n    pass\n\n# TREND (7d rolling)\ntry:\n    import numpy as np\n    df['_date'] = pd.to_datetime(df['order_date'])\n    daily = df.groupby('_date')[['revenue', 'units', 'discount', 'marketing_spend']].mean().sort_index()\n    for col in ['revenue', 'units', 'discount', 'marketing_spend']:\n        rolled = daily[col].rolling(7).mean().dropna()\n        if len(rolled) >= 2:\n            first_val = float(rolled.iloc[0])\n            last_val = float(rolled.iloc[-1])\n            if first_val != 0:\n                pct = round((last_val - first_val) / abs(first_val) * 100, 2)\n            else:\n                pct = 0.0\n            direction = 'up' if pct > 1 else ('down' if pct < -1 else 'flat')\n            result['trends'].append({\n                'column': col, 'period': '7d_rolling',\n                'direction': direction, 'pct_change': pct, 'segment': None\n            })\nexcept Exception:\n    pass\n\n# FORECASTING (simple linear extrapolation on revenue)\ntry:\n    import numpy as np\n    from scipy import stats as sp_stats\n    df['_date'] = pd.to_datetime(df['order_date'])\n    monthly = df.groupby(df['_date'].dt.to_period('M'))['revenue'].sum().sort_index()\n    if len(monthly) >= 3:\n        x = np.arange(len(monthly))\n        y = monthly.values.astype(float)\n        slope, intercept, r, p, se = sp_stats.linregress(x, y)\n        for step in [1, 2, 3]:\n            pred_x = len(monthly) - 1 + step\n            pred_val = float(intercept + slope * pred_x)\n            last_period = monthly.index[-1]\n            future_period = (last_period + step).strftime('%Y-%m')\n            result['forecast_points'].append({'period': future_period, 'value': round(pred_val, 2)})\n        r_val = round(float(r), 4)\n        p_val = round(float(p), 4)\n        result['statistical_tests'].append({\n            'test_name': 'Linear trend (revenue monthly)',\n            'statistic': round(float(slope), 4),\n            'p_value': p_val,\n            'interpretation': f'Monthly revenue linear trend slope={round(float(slope),4)}, r={r_val}, p={p_val}; {\"significant\" if p_val < 0.05 else \"no significant\"} linear trend'\n        })\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    'discount column treated as a rate (0-1); 7d rolling trend uses daily means for rates',\n    'Anomaly detection uses log1p transform for columns with abs(skew)>2',\n    'Forecasting uses OLS linear regression on monthly revenue totals',\n    'Segmentation limited to top 10 groups by count; customer_email excluded (high cardinality)',\n    'Notes column contains embedded instruction-like text in data; ignored per policy'\n]", "result_excerpt": "{\"revenue__marketing_spend\": 0.5685}", "row_count": 3000, "confidence": "high", "confidence_reason": "3000 rows", "assumptions": ["Forecasting uses OLS linear regression on monthly revenue totals", "25 duplicate rows were removed first"]}, {"id": "corr:revenue__units", "kind": "correlation", "claim": "revenue and units: r = -0.036", "code": "\n# \u2500\u2500\u2500 Standard statistics (deterministic) \u2500\u2500\u2500\nresult['builtin'] = []\n_targets, _segs, _date = ['revenue', 'units', 'discount', 'marketing_spend'], ['segment', 'region', 'customer_email'], 'order_date'\ntry:\n    if True:\n        for _i, _a in enumerate(_targets):\n            for _b in _targets[_i + 1:]:\n                if f'{_a}__{_b}' not in result['correlations'] and f'{_b}__{_a}' not in result['correlations']:\n                    _r = df[_a].corr(df[_b])\n                    if _r == _r:\n                        result['correlations'][f'{_a}__{_b}'] = round(float(_r), 4)\n                        result['builtin'].append(f'corr:{_a}__{_b}')\nexcept Exception:\n    pass\ntry:\n    if _date and True:\n        _month = pd.to_datetime(df[_date], errors='coerce').dt.to_period('M')\n        # A mid-month export compares the last two complete months (agents.utils.partial_last_month).\n        _d = pd.to_datetime(df[_date], errors='coerce').dropna()\n        _days = _d.dt.normalize().groupby(_d.dt.to_period('M')).nunique().sort_index()\n        if len(_days) >= 3 and _d.max().normalize() < _d.max().normalize() + pd.offsets.MonthEnd(0) and _days.iloc[-1] < 0.9 * _days.iloc[:-1].median():\n            _month = _month.where(_month != _days.index[-1])\n        # One definition of MoM (calendar-month totals), so the built-in value replaces the model's.\n        result['trends'] = [t for t in result['trends'] if not (isinstance(t, dict) and t.get('period') == 'MoM' and t.get('column') in _targets)]\n        # ponytail: values all in [0, 1] \u2192 a rate or flag, compared by month mean; anything else\n        # by month total. A semantic layer (Phase 4) can declare the aggregation instead.\n        def _mom(_frame, _col):\n            _agg = 'mean' if df[_col].dropna().between(0, 1).all() else 'sum'\n            _tot = _frame.groupby(_month.loc[_frame.index])[_col].agg(_agg).sort_index()\n            if len(_tot) < 2 or _tot.iloc[-2] == 0:\n                return None, 0\n            _last2 = _month.loc[_frame.index].isin(_tot.index[-2:])\n            _n = int(_frame.loc[_last2, _col].notna().sum())\n            return round(float((_tot.iloc[-1] / _tot.iloc[-2] - 1) * 100), 2), _n\n        for _c in _targets:\n            _jobs = [(None, df)]\n            if _segs:\n                _top = df[_segs[0]].value_counts().head(10).index\n                _jobs += [(str(_v), df[df[_segs[0]] == _v]) for _v in _top]\n            for _seg, _frame in _jobs:\n                _p, _n = _mom(_frame, _c)\n                if _p is not None:\n                    result['trends'].append({'column': _c, 'period': 'MoM', 'pct_change': _p, 'segment': _seg, 'n': _n,\n                                             'direction': 'up' if _p > 0 else 'down' if _p < 0 else 'flat'})\n                    result['builtin'].append(f'trend:{_c}' + (f' ({_seg})' if _seg else '') + ':MoM')\nexcept Exception:\n    pass\ntry:\n    if len(_segs) >= 2 and 'segmentation' in ['anomaly', 'correlation', 'eda', 'forecasting', 'segmentation', 'trend']:\n        _joint = '|'.join(_segs[:2])\n        for _c in _targets:\n            if any(s.get('segment_column') == _joint and s.get('metric_column') == _c for s in result['segments'] if isinstance(s, dict)):\n                continue\n            _g = df.groupby(_segs[:2])[_c].mean()\n            _n = df.groupby(_segs[:2]).size().sort_values(ascending=False).head(20).index\n            result['segments'].append({'segment_column': _joint, 'metric_column': _c, 'aggregation': 'mean',\n                                       'results': [{'name': f'{_a}|{_b}', 'value': round(float(_g[(_a, _b)]), 4)} for _a, _b in _n]})\n            result['builtin'].append(f'seg:{_joint}/{_c}')\nexcept Exception:\n    pass\n", "result_excerpt": "{\"revenue__units\": -0.036}", "row_count": 3000, "confidence": "medium", "confidence_reason": "weak association (|r| = 0.04)", "assumptions": ["Forecasting uses OLS linear regression on monthly revenue totals", "25 duplicate rows were removed first"]}, {"id": "corr:revenue__discount", "kind": "correlation", "claim": "revenue and discount: r = -0.019", "code": "\n# \u2500\u2500\u2500 Standard statistics (deterministic) \u2500\u2500\u2500\nresult['builtin'] = []\n_targets, _segs, _date = ['revenue', 'units', 'discount', 'marketing_spend'], ['segment', 'region', 'customer_email'], 'order_date'\ntry:\n    if True:\n        for _i, _a in enumerate(_targets):\n            for _b in _targets[_i + 1:]:\n                if f'{_a}__{_b}' not in result['correlations'] and f'{_b}__{_a}' not in result['correlations']:\n                    _r = df[_a].corr(df[_b])\n                    if _r == _r:\n                        result['correlations'][f'{_a}__{_b}'] = round(float(_r), 4)\n                        result['builtin'].append(f'corr:{_a}__{_b}')\nexcept Exception:\n    pass\ntry:\n    if _date and True:\n        _month = pd.to_datetime(df[_date], errors='coerce').dt.to_period('M')\n        # A mid-month export compares the last two complete months (agents.utils.partial_last_month).\n        _d = pd.to_datetime(df[_date], errors='coerce').dropna()\n        _days = _d.dt.normalize().groupby(_d.dt.to_period('M')).nunique().sort_index()\n        if len(_days) >= 3 and _d.max().normalize() < _d.max().normalize() + pd.offsets.MonthEnd(0) and _days.iloc[-1] < 0.9 * _days.iloc[:-1].median():\n            _month = _month.where(_month != _days.index[-1])\n        # One definition of MoM (calendar-month totals), so the built-in value replaces the model's.\n        result['trends'] = [t for t in result['trends'] if not (isinstance(t, dict) and t.get('period') == 'MoM' and t.get('column') in _targets)]\n        # ponytail: values all in [0, 1] \u2192 a rate or flag, compared by month mean; anything else\n        # by month total. A semantic layer (Phase 4) can declare the aggregation instead.\n        def _mom(_frame, _col):\n            _agg = 'mean' if df[_col].dropna().between(0, 1).all() else 'sum'\n            _tot = _frame.groupby(_month.loc[_frame.index])[_col].agg(_agg).sort_index()\n            if len(_tot) < 2 or _tot.iloc[-2] == 0:\n                return None, 0\n            _last2 = _month.loc[_frame.index].isin(_tot.index[-2:])\n            _n = int(_frame.loc[_last2, _col].notna().sum())\n            return round(float((_tot.iloc[-1] / _tot.iloc[-2] - 1) * 100), 2), _n\n        for _c in _targets:\n            _jobs = [(None, df)]\n            if _segs:\n                _top = df[_segs[0]].value_counts().head(10).index\n                _jobs += [(str(_v), df[df[_segs[0]] == _v]) for _v in _top]\n            for _seg, _frame in _jobs:\n                _p, _n = _mom(_frame, _c)\n                if _p is not None:\n                    result['trends'].append({'column': _c, 'period': 'MoM', 'pct_change': _p, 'segment': _seg, 'n': _n,\n                                             'direction': 'up' if _p > 0 else 'down' if _p < 0 else 'flat'})\n                    result['builtin'].append(f'trend:{_c}' + (f' ({_seg})' if _seg else '') + ':MoM')\nexcept Exception:\n    pass\ntry:\n    if len(_segs) >= 2 and 'segmentation' in ['anomaly', 'correlation', 'eda', 'forecasting', 'segmentation', 'trend']:\n        _joint = '|'.join(_segs[:2])\n        for _c in _targets:\n            if any(s.get('segment_column') == _joint and s.get('metric_column') == _c for s in result['segments'] if isinstance(s, dict)):\n                continue\n            _g = df.groupby(_segs[:2])[_c].mean()\n            _n = df.groupby(_segs[:2]).size().sort_values(ascending=False).head(20).index\n            result['segments'].append({'segment_column': _joint, 'metric_column': _c, 'aggregation': 'mean',\n                                       'results': [{'name': f'{_a}|{_b}', 'value': round(float(_g[(_a, _b)]), 4)} for _a, _b in _n]})\n            result['builtin'].append(f'seg:{_joint}/{_c}')\nexcept Exception:\n    pass\n", "result_excerpt": "{\"revenue__discount\": -0.019}", "row_count": 3000, "confidence": "medium", "confidence_reason": "weak association (|r| = 0.02)", "assumptions": ["discount column treated as a rate (0-1); 7d rolling trend uses daily means for rates", "Forecasting uses OLS linear regression on monthly revenue totals", "25 duplicate rows were removed first"]}, {"id": "corr:units__discount", "kind": "correlation", "claim": "units and discount: r = 0.044", "code": "\n# \u2500\u2500\u2500 Standard statistics (deterministic) \u2500\u2500\u2500\nresult['builtin'] = []\n_targets, _segs, _date = ['revenue', 'units', 'discount', 'marketing_spend'], ['segment', 'region', 'customer_email'], 'order_date'\ntry:\n    if True:\n        for _i, _a in enumerate(_targets):\n            for _b in _targets[_i + 1:]:\n                if f'{_a}__{_b}' not in result['correlations'] and f'{_b}__{_a}' not in result['correlations']:\n                    _r = df[_a].corr(df[_b])\n                    if _r == _r:\n                        result['correlations'][f'{_a}__{_b}'] = round(float(_r), 4)\n                        result['builtin'].append(f'corr:{_a}__{_b}')\nexcept Exception:\n    pass\ntry:\n    if _date and True:\n        _month = pd.to_datetime(df[_date], errors='coerce').dt.to_period('M')\n        # A mid-month export compares the last two complete months (agents.utils.partial_last_month).\n        _d = pd.to_datetime(df[_date], errors='coerce').dropna()\n        _days = _d.dt.normalize().groupby(_d.dt.to_period('M')).nunique().sort_index()\n        if len(_days) >= 3 and _d.max().normalize() < _d.max().normalize() + pd.offsets.MonthEnd(0) and _days.iloc[-1] < 0.9 * _days.iloc[:-1].median():\n