data: {"type": "evidence", "data": [{"id": "source:data", "kind": "source", "claim": "Loaded 1,500 rows \u00d7 12 columns from a JSON file.", "code": "pd.read_json(<uploaded file>)", "result_excerpt": "{\"roles\": {\"id\": [\"Appointment ID\", \"Trailer Number\", \"License Plate\"], \"category\": [\"Facility\", \"Door\", \"Carrier\", \"Direction\", \"Status\", \"Driver Name\"], \"date\": [\"Appointment Time\", \"Arrived At\", \"Departed At\"]}, \"personal_data\": {\"Driver Name\": \"name\", \"License Plate\": \"vehicle\"}, \"fingerprint\": \"8e957216ef8eed48\"}", "row_count": 1500, "confidence": "high", "confidence_reason": "Read as-is: no layout guessing was needed.", "assumptions": ["2 columns hold personal data; their values are masked before any model sees them."]}, {"id": "clean:audit", "kind": "cleaning", "claim": "Cleaning: 1500 \u2192 1500 rows, 4 logged changes", "code": "# cleaning rules-v1\nkeep('Arrived At', conditional)\nkeep('Departed At', conditional)\nflag('*', cancel)\nflag('dwell_hours', out_of_range)", "result_excerpt": "{\"rows_before\": 1500, \"rows_after\": 1500, \"decisions\": [[\"Arrived At\", \"keep\", 0, 0], [\"Departed At\", \"keep\", 0, 0], [\"*\", \"flag\", 38, 0], [\"dwell_hours\", \"flag\", 3, 0]]}", "row_count": 1500, "confidence": "high", "confidence_reason": "rule-based; every change below is logged", "assumptions": ["Arrived At: Filled only for rows whose status needs it, so other rows are blank by design; 0% of those rows have no value. Kept as it is.", "Departed At: Filled only for rows whose status needs it, so other rows are blank by design; 0% of those rows have no value. Kept as it is.", "*: 38 cancelled shipments, lines or appointments: left out of every count and rate; kept in the data.", "dwell_hours: 3 values outside the valid range (ge 0); kept, check them."]}, {"id": "trend:dwell_hours:MoM", "kind": "trend", "claim": "dwell_hours MoM: -1.7%", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n            base2 = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_mo = base2.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            numer_mo = df_sale[df_sale[hba_col] >= 0].groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            ota_mo = (numer_mo / denom_mo).dropna()\n            vals_o = ota_mo.values\n            if len(vals_o) >= 2:\n                pct_o = float((vals_o[-1] - vals_o[-2]) / abs(vals_o[-2]) * 100) if vals_o[-2] != 0 else 0.0\n                dir_o = \"up\" if pct_o > 1 else (\"down\" if pct_o < -1 else \"flat\")\n                trend_list.append({\"column\": hba_col, \"period\": \"MoM\", \"direction\": dir_o, \"pct_change\": round(pct_o, 2), \"segment\": None})\n    result['trends'] = trend_list\nexcept Exception:\n    pass\n\n# --- Anomalies ---\ntry:\n    anomaly_list = []\n    cap = 25\n    for col in numeric_cols:\n        if cap <= 0:\n            break\n        s = df_sale[col].dropna()\n        if s.nunique() < 5 or s.isna().mean() > 0.5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if abs(skew) > 2:\n            if s.min() < 0:\n                shift = -s.min() + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1, q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo3, hi3 = q1 - 3 * iqr, q3 + 3 * iqr\n        lo4, hi4 = q1 - 4 * iqr, q3 + 4 * iqr\n        lo5, hi5 = q1 - 5 * iqr, q3 + 5 * iqr\n        flagged = df_sale[(df_sale[col].notna()) & ((s_t < lo3) | (s_t > hi3))]\n        if len(flagged) / max(len(s), 1) > 0.05:\n            anomaly_list.append({\"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\", \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually.\"})\n            continue\n        if abs(skew) > 2:\n            lo_orig = float(np.expm1(lo3) - shift)\n            hi_orig = float(np.expm1(hi3) - shift)\n        else:\n            lo_orig, hi_orig = float(lo3), float(hi3)\n        exp_range = f\"[{lo_orig:.2f}, {hi_orig:.2f}]\"\n        for idx, row in flagged.iterrows():\n            if cap <= 0:\n                break\n            raw_val = float(df_sale.loc[idx, col])\n            t_val = float(s_t.loc[idx]) if idx in s_t.index else float('nan')\n            if t_val > hi5 or t_val < lo5:\n                sev = \"critical\"\n            elif t_val > hi4 or t_val < lo4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            anomaly_list.append({\"column\": col, \"row_index\": int(idx), \"value\": raw_val,\n                \"expected_range\": exp_range, \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val:.2f} lies outside expected range {exp_range}.\"})\n            cap -= 1\n    result['anomalies'] = anomaly_list\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Cancelled rows (row_kind='cancelled') excluded from all KPIs and segments.\",\n    \"avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted.\",\n    \"on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion.\",\n    \"Anomaly detection uses 3\u00d7IQR extreme boundary; log1p applied for skewed columns.\",\n    \"Trends computed month-over-month using Appointment Time as the date column.\"\n]", "result_excerpt": "{\"column\": \"dwell_hours\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -1.69, \"segment\": null}", "row_count": 1356, "confidence": "high", "confidence_reason": "1356 rows", "assumptions": ["avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted."]}, {"id": "trend:Appointment ID:MoM", "kind": "trend", "claim": "Appointment ID MoM: -98.7%", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n            base2 = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_mo = base2.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            numer_mo = df_sale[df_sale[hba_col] >= 0].groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            ota_mo = (numer_mo / denom_mo).dropna()\n            vals_o = ota_mo.values\n            if len(vals_o) >= 2:\n                pct_o = float((vals_o[-1] - vals_o[-2]) / abs(vals_o[-2]) * 100) if vals_o[-2] != 0 else 0.0\n                dir_o = \"up\" if pct_o > 1 else (\"down\" if pct_o < -1 else \"flat\")\n                trend_list.append({\"column\": hba_col, \"period\": \"MoM\", \"direction\": dir_o, \"pct_change\": round(pct_o, 2), \"segment\": None})\n    result['trends'] = trend_list\nexcept Exception:\n    pass\n\n# --- Anomalies ---\ntry:\n    anomaly_list = []\n    cap = 25\n    for col in numeric_cols:\n        if cap <= 0:\n            break\n        s = df_sale[col].dropna()\n        if s.nunique() < 5 or s.isna().mean() > 0.5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if abs(skew) > 2:\n            if s.min() < 0:\n                shift = -s.min() + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1, q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo3, hi3 = q1 - 3 * iqr, q3 + 3 * iqr\n        lo4, hi4 = q1 - 4 * iqr, q3 + 4 * iqr\n        lo5, hi5 = q1 - 5 * iqr, q3 + 5 * iqr\n        flagged = df_sale[(df_sale[col].notna()) & ((s_t < lo3) | (s_t > hi3))]\n        if len(flagged) / max(len(s), 1) > 0.05:\n            anomaly_list.append({\"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\", \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually.\"})\n            continue\n        if abs(skew) > 2:\n            lo_orig = float(np.expm1(lo3) - shift)\n            hi_orig = float(np.expm1(hi3) - shift)\n        else:\n            lo_orig, hi_orig = float(lo3), float(hi3)\n        exp_range = f\"[{lo_orig:.2f}, {hi_orig:.2f}]\"\n        for idx, row in flagged.iterrows():\n            if cap <= 0:\n                break\n            raw_val = float(df_sale.loc[idx, col])\n            t_val = float(s_t.loc[idx]) if idx in s_t.index else float('nan')\n            if t_val > hi5 or t_val < lo5:\n                sev = \"critical\"\n            elif t_val > hi4 or t_val < lo4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            anomaly_list.append({\"column\": col, \"row_index\": int(idx), \"value\": raw_val,\n                \"expected_range\": exp_range, \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val:.2f} lies outside expected range {exp_range}.\"})\n            cap -= 1\n    result['anomalies'] = anomaly_list\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Cancelled rows (row_kind='cancelled') excluded from all KPIs and segments.\",\n    \"avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted.\",\n    \"on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion.\",\n    \"Anomaly detection uses 3\u00d7IQR extreme boundary; log1p applied for skewed columns.\",\n    \"Trends computed month-over-month using Appointment Time as the date column.\"\n]", "result_excerpt": "{\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -98.68, \"segment\": null}", "row_count": 1500, "confidence": "high", "confidence_reason": "1500 rows", "assumptions": []}, {"id": "trend:hours_before_appointment:MoM", "kind": "trend", "claim": "hours_before_appointment MoM: -51.9%", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n            base2 = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_mo = base2.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            numer_mo = df_sale[df_sale[hba_col] >= 0].groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            ota_mo = (numer_mo / denom_mo).dropna()\n            vals_o = ota_mo.values\n            if len(vals_o) >= 2:\n                pct_o = float((vals_o[-1] - vals_o[-2]) / abs(vals_o[-2]) * 100) if vals_o[-2] != 0 else 0.0\n                dir_o = \"up\" if pct_o > 1 else (\"down\" if pct_o < -1 else \"flat\")\n                trend_list.append({\"column\": hba_col, \"period\": \"MoM\", \"direction\": dir_o, \"pct_change\": round(pct_o, 2), \"segment\": None})\n    result['trends'] = trend_list\nexcept Exception:\n    pass\n\n# --- Anomalies ---\ntry:\n    anomaly_list = []\n    cap = 25\n    for col in numeric_cols:\n        if cap <= 0:\n            break\n        s = df_sale[col].dropna()\n        if s.nunique() < 5 or s.isna().mean() > 0.5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if abs(skew) > 2:\n            if s.min() < 0:\n                shift = -s.min() + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1, q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo3, hi3 = q1 - 3 * iqr, q3 + 3 * iqr\n        lo4, hi4 = q1 - 4 * iqr, q3 + 4 * iqr\n        lo5, hi5 = q1 - 5 * iqr, q3 + 5 * iqr\n        flagged = df_sale[(df_sale[col].notna()) & ((s_t < lo3) | (s_t > hi3))]\n        if len(flagged) / max(len(s), 1) > 0.05:\n            anomaly_list.append({\"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\", \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually.\"})\n            continue\n        if abs(skew) > 2:\n            lo_orig = float(np.expm1(lo3) - shift)\n            hi_orig = float(np.expm1(hi3) - shift)\n        else:\n            lo_orig, hi_orig = float(lo3), float(hi3)\n        exp_range = f\"[{lo_orig:.2f}, {hi_orig:.2f}]\"\n        for idx, row in flagged.iterrows():\n            if cap <= 0:\n                break\n            raw_val = float(df_sale.loc[idx, col])\n            t_val = float(s_t.loc[idx]) if idx in s_t.index else float('nan')\n            if t_val > hi5 or t_val < lo5:\n                sev = \"critical\"\n            elif t_val > hi4 or t_val < lo4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            anomaly_list.append({\"column\": col, \"row_index\": int(idx), \"value\": raw_val,\n                \"expected_range\": exp_range, \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val:.2f} lies outside expected range {exp_range}.\"})\n            cap -= 1\n    result['anomalies'] = anomaly_list\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Cancelled rows (row_kind='cancelled') excluded from all KPIs and segments.\",\n    \"avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted.\",\n    \"on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion.\",\n    \"Anomaly detection uses 3\u00d7IQR extreme boundary; log1p applied for skewed columns.\",\n    \"Trends computed month-over-month using Appointment Time as the date column.\"\n]", "result_excerpt": "{\"column\": \"hours_before_appointment\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -51.87, \"segment\": null}", "row_count": 979, "confidence": "high", "confidence_reason": "979 rows", "assumptions": ["on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion."]}, {"id": "seg:Facility/dwell_hours:ratio:avg_dwell_hours", "kind": "segment", "claim": "avg_dwell_hours (from dwell_hours) by Facility (1 groups)", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n            base2 = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_mo = base2.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            numer_mo = df_sale[df_sale[hba_col] >= 0].groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            ota_mo = (numer_mo / denom_mo).dropna()\n            vals_o = ota_mo.values\n            if len(vals_o) >= 2:\n                pct_o = float((vals_o[-1] - vals_o[-2]) / abs(vals_o[-2]) * 100) if vals_o[-2] != 0 else 0.0\n                dir_o = \"up\" if pct_o > 1 else (\"down\" if pct_o < -1 else \"flat\")\n                trend_list.append({\"column\": hba_col, \"period\": \"MoM\", \"direction\": dir_o, \"pct_change\": round(pct_o, 2), \"segment\": None})\n    result['trends'] = trend_list\nexcept Exception:\n    pass\n\n# --- Anomalies ---\ntry:\n    anomaly_list = []\n    cap = 25\n    for col in numeric_cols:\n        if cap <= 0:\n            break\n        s = df_sale[col].dropna()\n        if s.nunique() < 5 or s.isna().mean() > 0.5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if abs(skew) > 2:\n            if s.min() < 0:\n                shift = -s.min() + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1, q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo3, hi3 = q1 - 3 * iqr, q3 + 3 * iqr\n        lo4, hi4 = q1 - 4 * iqr, q3 + 4 * iqr\n        lo5, hi5 = q1 - 5 * iqr, q3 + 5 * iqr\n        flagged = df_sale[(df_sale[col].notna()) & ((s_t < lo3) | (s_t > hi3))]\n        if len(flagged) / max(len(s), 1) > 0.05:\n            anomaly_list.append({\"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\", \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually.\"})\n            continue\n        if abs(skew) > 2:\n            lo_orig = float(np.expm1(lo3) - shift)\n            hi_orig = float(np.expm1(hi3) - shift)\n        else:\n            lo_orig, hi_orig = float(lo3), float(hi3)\n        exp_range = f\"[{lo_orig:.2f}, {hi_orig:.2f}]\"\n        for idx, row in flagged.iterrows():\n            if cap <= 0:\n                break\n            raw_val = float(df_sale.loc[idx, col])\n            t_val = float(s_t.loc[idx]) if idx in s_t.index else float('nan')\n            if t_val > hi5 or t_val < lo5:\n                sev = \"critical\"\n            elif t_val > hi4 or t_val < lo4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            anomaly_list.append({\"column\": col, \"row_index\": int(idx), \"value\": raw_val,\n                \"expected_range\": exp_range, \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val:.2f} lies outside expected range {exp_range}.\"})\n            cap -= 1\n    result['anomalies'] = anomaly_list\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Cancelled rows (row_kind='cancelled') excluded from all KPIs and segments.\",\n    \"avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted.\",\n    \"on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion.\",\n    \"Anomaly detection uses 3\u00d7IQR extreme boundary; log1p applied for skewed columns.\",\n    \"Trends computed month-over-month using Appointment Time as the date column.\"\n]", "result_excerpt": "{\"segment_column\": \"Facility\", \"metric_column\": \"dwell_hours\", \"aggregation\": \"ratio\", \"results\": [{\"name\": \"overall\", \"value\": 2.317981809}], \"label\": \"avg_dwell_hours\"}", "row_count": 1356, "confidence": "high", "confidence_reason": "1356 rows", "assumptions": ["avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted."]}, {"id": "seg:Facility/hours_before_appointment:ratio:on_time_arrival", "kind": "segment", "claim": "on_time_arrival (from hours_before_appointment) by Facility (1 groups)", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n            base2 = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_mo = base2.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            numer_mo = df_sale[df_sale[hba_col] >= 0].groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n            ota_mo = (numer_mo / denom_mo).dropna()\n            vals_o = ota_mo.values\n            if len(vals_o) >= 2:\n                pct_o = float((vals_o[-1] - vals_o[-2]) / abs(vals_o[-2]) * 100) if vals_o[-2] != 0 else 0.0\n                dir_o = \"up\" if pct_o > 1 else (\"down\" if pct_o < -1 else \"flat\")\n                trend_list.append({\"column\": hba_col, \"period\": \"MoM\", \"direction\": dir_o, \"pct_change\": round(pct_o, 2), \"segment\": None})\n    result['trends'] = trend_list\nexcept Exception:\n    pass\n\n# --- Anomalies ---\ntry:\n    anomaly_list = []\n    cap = 25\n    for col in numeric_cols:\n        if cap <= 0:\n            break\n        s = df_sale[col].dropna()\n        if s.nunique() < 5 or s.isna().mean() > 0.5:\n            continue\n        skew = float(s.skew())\n        shift = 0\n        if abs(skew) > 2:\n            if s.min() < 0:\n                shift = -s.min() + 1\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n        q1, q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        iqr = q3 - q1\n        lo3, hi3 = q1 - 3 * iqr, q3 + 3 * iqr\n        lo4, hi4 = q1 - 4 * iqr, q3 + 4 * iqr\n        lo5, hi5 = q1 - 5 * iqr, q3 + 5 * iqr\n        flagged = df_sale[(df_sale[col].notna()) & ((s_t < lo3) | (s_t > hi3))]\n        if len(flagged) / max(len(s), 1) > 0.05:\n            anomaly_list.append({\"column\": col, \"row_index\": None, \"value\": None,\n                \"expected_range\": f\"heavy-tailed distribution\",\n                \"severity\": \"low\", \"explanation\": f\"{col} is heavy-tailed; extreme values are natural, not flagged individually.\"})\n            continue\n        if abs(skew) > 2:\n            lo_orig = float(np.expm1(lo3) - shift)\n            hi_orig = float(np.expm1(hi3) - shift)\n        else:\n            lo_orig, hi_orig = float(lo3), float(hi3)\n        exp_range = f\"[{lo_orig:.2f}, {hi_orig:.2f}]\"\n        for idx, row in flagged.iterrows():\n            if cap <= 0:\n                break\n            raw_val = float(df_sale.loc[idx, col])\n            t_val = float(s_t.loc[idx]) if idx in s_t.index else float('nan')\n            if t_val > hi5 or t_val < lo5:\n                sev = \"critical\"\n            elif t_val > hi4 or t_val < lo4:\n                sev = \"high\"\n            else:\n                sev = \"medium\"\n            anomaly_list.append({\"column\": col, \"row_index\": int(idx), \"value\": raw_val,\n                \"expected_range\": exp_range, \"severity\": sev,\n                \"explanation\": f\"{col} value {raw_val:.2f} lies outside expected range {exp_range}.\"})\n            cap -= 1\n    result['anomalies'] = anomaly_list\nexcept Exception:\n    pass\n\nresult['assumptions'] = [\n    \"Cancelled rows (row_kind='cancelled') excluded from all KPIs and segments.\",\n    \"avg_dwell uses pre-computed dwell_hours column; only non-negative dwell rows counted.\",\n    \"on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion.\",\n    \"Anomaly detection uses 3\u00d7IQR extreme boundary; log1p applied for skewed columns.\",\n    \"Trends computed month-over-month using Appointment Time as the date column.\"\n]", "result_excerpt": "{\"segment_column\": \"Facility\", \"metric_column\": \"hours_before_appointment\", \"aggregation\": \"ratio\", \"results\": [{\"name\": \"overall\", \"value\": 0.7203826343}], \"label\": \"on_time_arrival\"}", "row_count": 979, "confidence": "high", "confidence_reason": "979 rows", "assumptions": ["on_time_arrival uses pre-computed hours_before_appointment >= 0 as on-time criterion."]}, {"id": "seg:Facility/dwell_hours:ratio:visits_over_2h", "kind": "segment", "claim": "visits_over_2h (from dwell_hours) by Facility (1 groups)", "code": "import numpy as np\nfrom scipy import stats\n\n# Filter to sale rows only (exclude cancelled)\ncancelled_statuses = ['cancelled', 'canceled', 'cancel', 'void', 'voided', 'no show', 'missed']\ndf_sale = df[df['row_kind'] == 'sale'].copy()\n\n# Parse dates\nfor col in ['Appointment Time', 'Arrived At', 'Departed At']:\n    df_sale[col] = pd.to_datetime(df_sale[col], errors='coerce')\n\n# Use pre-computed columns\ndwell_col = 'dwell_hours'\nhba_col = 'hours_before_appointment'\nhla_col = 'hours_late_to_appointment'\n\nnumeric_cols = [c for c in [dwell_col, hba_col, hla_col] if c in df_sale.columns]\n\n# --- EDA ---\ntry:\n    eda = {}\n    for col in numeric_cols:\n        s = df_sale[col].dropna()\n        if len(s) > 0:\n            eda[col] = {\n                \"mean\": float(s.mean()), \"std\": float(s.std()),\n                \"min\": float(s.min()), \"max\": float(s.max()),\n                \"median\": float(s.median()), \"count\": int(s.count())\n            }\n    result['eda_summary'] = eda\nexcept Exception:\n    pass\n\n# --- KPIs as segments ---\ntry:\n    seg_results = []\n\n    # avg_dwell: sum dwell where dwell >= 0 / count distinct appts where dwell >= 0\n    valid_dwell = df_sale[df_sale[dwell_col] >= 0] if dwell_col in df_sale.columns else df_sale.iloc[0:0]\n    avg_dwell_val = float(valid_dwell[dwell_col].sum() / valid_dwell['Appointment ID'].nunique()) if valid_dwell['Appointment ID'].nunique() > 0 else float('nan')\n\n    # on_time_arrival: appts where hours_before_appointment >= 0 / appts where both arrived and appt time exist\n    if hba_col in df_sale.columns:\n        denom_ota = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]['Appointment ID'].nunique()\n        numer_ota = df_sale[df_sale[hba_col] >= 0]['Appointment ID'].nunique()\n        ota_val = float(numer_ota / denom_ota) if denom_ota > 0 else float('nan')\n    else:\n        ota_val = float('nan')\n\n    # visits_over_2h\n    if dwell_col in df_sale.columns:\n        denom_v2h = valid_dwell['Appointment ID'].nunique()\n        numer_v2h = df_sale[df_sale[dwell_col] > 2]['Appointment ID'].nunique()\n        v2h_val = float(numer_v2h / denom_v2h) if denom_v2h > 0 else float('nan')\n    else:\n        v2h_val = float('nan')\n\n    # no_shows\n    no_show_statuses = ['no show', 'missed']\n    no_shows_val = int(df_sale[df_sale['Status'].str.lower().isin(no_show_statuses)]['Appointment ID'].nunique())\n\n    # total visits\n    visits_val = int(df_sale['Appointment ID'].nunique())\n\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"avg_dwell_hours\", \"results\": [{\"name\": \"overall\", \"value\": avg_dwell_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": hba_col if hba_col in df_sale.columns else \"Appointment ID\",\n        \"aggregation\": \"ratio\", \"label\": \"on_time_arrival\",\n        \"results\": [{\"name\": \"overall\", \"value\": ota_val}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n        \"label\": \"visits_over_2h\", \"results\": [{\"name\": \"overall\", \"value\": v2h_val}]})\n    seg_results.append({\"segment_column\": \"Status\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"no_shows\", \"results\": [{\"name\": \"overall\", \"value\": float(no_shows_val)}]})\n    seg_results.append({\"segment_column\": \"Facility\", \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n        \"label\": \"visits\", \"results\": [{\"name\": \"overall\", \"value\": float(visits_val)}]})\n\n    # Segmentation by Facility, Carrier, Direction\n    for seg_col in ['Facility', 'Carrier', 'Direction']:\n        if seg_col not in df_sale.columns:\n            continue\n        # avg_dwell by segment\n        if dwell_col in df_sale.columns:\n            grp = valid_dwell.groupby(seg_col)\n            dwell_by_seg = (grp[dwell_col].sum() / grp['Appointment ID'].nunique()).reset_index()\n            dwell_by_seg.columns = [seg_col, 'val']\n            top = dwell_by_seg.nlargest(10, 'val')\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": dwell_col, \"aggregation\": \"ratio\",\n                \"label\": \"avg_dwell_hours\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top.iterrows()]})\n        # on_time_arrival by segment\n        if hba_col in df_sale.columns:\n            base = df_sale[df_sale['Arrived At'].notna() & df_sale['Appointment Time'].notna()]\n            denom_g = base.groupby(seg_col)['Appointment ID'].nunique()\n            numer_g = df_sale[df_sale[hba_col] >= 0].groupby(seg_col)['Appointment ID'].nunique()\n            ota_g = (numer_g / denom_g).dropna().reset_index()\n            ota_g.columns = [seg_col, 'val']\n            seg_results.append({\"segment_column\": seg_col, \"metric_column\": hba_col, \"aggregation\": \"ratio\",\n                \"label\": \"on_time_arrival\",\n                \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in ota_g.iterrows()]})\n        # visits by segment\n        visits_g = df_sale.groupby(seg_col)['Appointment ID'].nunique().reset_index()\n        visits_g.columns = [seg_col, 'val']\n        top_v = visits_g.nlargest(10, 'val')\n        seg_results.append({\"segment_column\": seg_col, \"metric_column\": \"Appointment ID\", \"aggregation\": \"count\",\n            \"label\": \"visits\",\n            \"results\": [{\"name\": str(r[seg_col]), \"value\": float(r['val'])} for _, r in top_v.iterrows()]})\n\n    result['segments'] = seg_results\nexcept Exception:\n    pass\n\n# --- Trends (MoM) ---\ntry:\n    df_sale['month'] = df_sale['Appointment Time'].dt.to_period('M')\n    trend_list = []\n    months_sorted = sorted(df_sale['month'].dropna().unique())\n    if len(months_sorted) >= 2:\n        # avg_dwell MoM\n        if dwell_col in df_sale.columns:\n            vd = df_sale[df_sale[dwell_col] >= 0]\n            mo_dwell = (vd.groupby('month')[dwell_col].sum() / vd.groupby('month')['Appointment ID'].nunique()).reindex(months_sorted)\n            vals = mo_dwell.dropna().values\n            if len(vals) >= 2:\n                pct = float((vals[-1] - vals[-2]) / abs(vals[-2]) * 100) if vals[-2] != 0 else 0.0\n                direction = \"up\" if pct > 1 else (\"down\" if pct < -1 else \"flat\")\n                trend_list.append({\"column\": dwell_col, \"period\": \"MoM\", \"direction\": direction, \"pct_change\": round(pct, 2), \"segment\": None})\n        # visits MoM\n        mo_visits = df_sale.groupby('month')['Appointment ID'].nunique().reindex(months_sorted)\n        vals_v = mo_visits.dropna().values\n        if len(vals_v) >= 2:\n            pct_v = float((vals_v[-1] - vals_v[-2]) / abs(vals_v[-2]) * 100) if vals_v[-2] != 0 else 0.0\n            dir_v = \"up\" if pct_v > 1 else (\"down\" if pct_v < -1 else \"flat\")\n            trend_list.append({\"column\": \"Appointment ID\", \"period\": \"MoM\", \"direction\": dir_v, \"pct_change\": round(pct_v, 2), \"segment\": None})\n        # on_time_arrival MoM\n        if hba_col in df_sale.columns:\n           