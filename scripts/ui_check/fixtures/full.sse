month.loc[_frame.index])[_col].agg(_agg).sort_index()\n            if len(_tot) < 2 or _tot.iloc[-2] == 0:\n                return None, 0\n            _last2 = _month.loc[_frame.index].isin(_tot.index[-2:])\n            _n = int(_frame.loc[_last2, _col].notna().sum())\n            return round(float((_tot.iloc[-1] / _tot.iloc[-2] - 1) * 100), 2), _n\n        for _c in _targets:\n            _jobs = [(None, df)]\n            if _segs:\n                _top = df[_segs[0]].value_counts().head(10).index\n                _jobs += [(str(_v), df[df[_segs[0]] == _v]) for _v in _top]\n            for _seg, _frame in _jobs:\n                _p, _n = _mom(_frame, _c)\n                if _p is not None:\n                    result['trends'].append({'column': _c, 'period': 'MoM', 'pct_change': _p, 'segment': _seg, 'n': _n,\n                                             'direction': 'up' if _p > 0 else 'down' if _p < 0 else 'flat'})\n                    result['builtin'].append(f'trend:{_c}' + (f' ({_seg})' if _seg else '') + ':MoM')\nexcept Exception:\n    pass\ntry:\n    if len(_segs) >= 2 and 'segmentation' in ['anomaly', 'correlation', 'eda', 'hypothesis', 'segmentation', 'trend']:\n        _joint = '|'.join(_segs[:2])\n        for _c in _targets:\n            if any(s.get('segment_column') == _joint and s.get('metric_column') == _c for s in result['segments'] if isinstance(s, dict)):\n                continue\n            _g = df.groupby(_segs[:2])[_c].mean()\n            _n = df.groupby(_segs[:2]).size().sort_values(ascending=False).head(20).index\n            result['segments'].append({'segment_column': _joint, 'metric_column': _c, 'aggregation': 'mean',\n                                       'results': [{'name': f'{_a}|{_b}', 'value': round(float(_g[(_a, _b)]), 4)} for _a, _b in _n]})\n            result['builtin'].append(f'seg:{_joint}/{_c}')\nexcept Exception:\n    pass\n", "result_excerpt": "{\"column\": \"discount\", \"period\": \"MoM\", \"direction\": \"up\", \"pct_change\": 7.94, \"segment\": \"B\"}", "row_count": 171, "confidence": "high", "confidence_reason": "171 rows", "assumptions": ["Discount is a rate (0-1); MoM uses mean not sum for discount.", "Anomaly detection uses log1p transform for skewed columns (|skew|>2).", "Correlations reported only for |r|>=0.2."]}, {"id": "trend:discount (C):MoM", "kind": "trend", "claim": "discount (C) MoM: -15.9%", "code": "\n# \u2500\u2500\u2500 Standard statistics (deterministic, fill gaps only) \u2500\u2500\u2500\nresult['builtin'] = []\n_targets, _segs, _date = ['revenue', 'discount'], ['segment', 'region'], 'order_date'\ntry:\n    if True:\n        for _i, _a in enumerate(_targets):\n            for _b in _targets[_i + 1:]:\n                if f'{_a}__{_b}' not in result['correlations'] and f'{_b}__{_a}' not in result['correlations']:\n                    _r = df[_a].corr(df[_b])\n                    if _r == _r:\n                        result['correlations'][f'{_a}__{_b}'] = round(float(_r), 4)\n                        result['builtin'].append(f'corr:{_a}__{_b}')\nexcept Exception:\n    pass\ntry:\n    if _date and True:\n        _month = pd.to_datetime(df[_date], errors='coerce').dt.to_period('M')\n        # One definition of MoM (calendar-month totals), so the built-in value replaces the model's.\n        result['trends'] = [t for t in result['trends'] if not (isinstance(t, dict) and t.get('period') == 'MoM' and t.get('column') in _targets)]\n        # ponytail: values all in [0, 1] \u2192 a rate or flag, compared by month mean; anything else\n        # by month total. A semantic layer (Phase 4) can declare the aggregation instead.\n        def _mom(_frame, _col):\n            _agg = 'mean' if df[_col].dropna().between(0, 1).all() else 'sum'\n            _tot = _frame.groupby(_month.loc[_frame.index])[_col].agg(_agg).sort_index()\n            if len(_tot) < 2 or _tot.iloc[-2] == 0:\n                return None, 0\n            _last2 = _month.loc[_frame.index].isin(_tot.index[-2:])\n            _n = int(_frame.loc[_last2, _col].notna().sum())\n            return round(float((_tot.iloc[-1] / _tot.iloc[-2] - 1) * 100), 2), _n\n        for _c in _targets:\n            _jobs = [(None, df)]\n            if _segs:\n                _top = df[_segs[0]].value_counts().head(10).index\n                _jobs += [(str(_v), df[df[_segs[0]] == _v]) for _v in _top]\n            for _seg, _frame in _jobs:\n                _p, _n = _mom(_frame, _c)\n                if _p is not None:\n                    result['trends'].append({'column': _c, 'period': 'MoM', 'pct_change': _p, 'segment': _seg, 'n': _n,\n                                             'direction': 'up' if _p > 0 else 'down' if _p < 0 else 'flat'})\n                    result['builtin'].append(f'trend:{_c}' + (f' ({_seg})' if _seg else '') + ':MoM')\nexcept Exception:\n    pass\ntry:\n    if len(_segs) >= 2 and 'segmentation' in ['anomaly', 'correlation', 'eda', 'hypothesis', 'segmentation', 'trend']:\n        _joint = '|'.join(_segs[:2])\n        for _c in _targets:\n            if any(s.get('segment_column') == _joint and s.get('metric_column') == _c for s in result['segments'] if isinstance(s, dict)):\n                continue\n            _g = df.groupby(_segs[:2])[_c].mean()\n            _n = df.groupby(_segs[:2]).size().sort_values(ascending=False).head(20).index\n            result['segments'].append({'segment_column': _joint, 'metric_column': _c, 'aggregation': 'mean',\n                                       'results': [{'name': f'{_a}|{_b}', 'value': round(float(_g[(_a, _b)]), 4)} for _a, _b in _n]})\n            result['builtin'].append(f'seg:{_joint}/{_c}')\nexcept Exception:\n    pass\n", "result_excerpt": "{\"column\": \"discount\", \"period\": \"MoM\", \"direction\": \"down\", \"pct_change\": -15.94, \"segment\": \"C\"}", "row_count": 150, "confidence": "high", "confidence_reason": "150 rows", "assumptions": ["Discount is a rate (0-1); MoM uses mean not sum for discount.", "Anomaly detection uses log1p transform for skewed columns (|skew|>2).", "Correlations reported only for |r|>=0.2."]}, {"id": "seg:segment/revenue", "kind": "segment", "claim": "mean revenue by segment (3 groups)", "code": "try:\n    num_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    for col in num_cols:\n        s = df[col].dropna()\n        result['eda_summary'][col] = {\n            'mean': float(s.mean()), 'std': float(s.std()),\n            'min': float(s.min()), 'max': float(s.max()),\n            'median': float(s.median()), 'count': int(s.count())\n        }\nexcept Exception as e:\n    result['assumptions'].append(f\"EDA partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    pairs = [(a, b) for i, a in enumerate(num_cols) for b in num_cols[i+1:]]\n    for a, b in pairs:\n        sub = df[[a, b]].dropna()\n        if len(sub) < 10:\n            continue\n        r, _ = stats.pearsonr(sub[a], sub[b])\n        if abs(r) >= 0.2:\n            result['correlations'][f'{a}__{b}'] = round(float(r), 4)\nexcept Exception as e:\n    result['assumptions'].append(f\"Correlation partial failure: {e}\")\n\ntry:\n    seg_cols = ['segment', 'region']\n    target_metrics = ['revenue', 'discount']\n    for seg in seg_cols:\n        for metric in target_metrics:\n            grp = df.groupby(seg)[metric].mean().nlargest(10)\n            result['segments'].append({\n                'segment_column': seg,\n                'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': str(k), 'value': round(float(v), 4)} for k, v in grp.items()]\n            })\n        cnt = df.groupby(seg)[seg].count().nlargest(10)\n        result['segments'].append({\n            'segment_column': seg,\n            'metric_column': seg,\n            'aggregation': 'count',\n            'results': [{'name': str(k), 'value': int(v)} for k, v in cnt.items()]\n        })\n    if len(seg_cols) >= 2:\n        for metric in target_metrics:\n            grp2 = df.groupby(seg_cols)[metric].mean()\n            top10 = grp2.nlargest(10)\n            result['segments'].append({\n                'segment_column': f'{seg_cols[0]}|{seg_cols[1]}',\n                'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': f'{k[0]}|{k[1]}', 'value': round(float(v), 4)} for k, v in top10.items()]\n            })\nexcept Exception as e:\n    result['assumptions'].append(f\"Segmentation partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    df['order_date'] = pd.to_datetime(df['order_date'])\n    df['_ym'] = df['order_date'].dt.to_period('M')\n    for metric in ['revenue', 'discount']:\n        monthly = df.groupby('_ym')[metric].mean().sort_index()\n        if len(monthly) >= 2:\n            periods = monthly.index\n            vals = monthly.values\n            last, prev = float(vals[-1]), float(vals[-2])\n            pct = round((last - prev) / prev * 100, 4) if prev != 0 else 0.0\n            direction = 'up' if pct > 0.5 else ('down' if pct < -0.5 else 'flat')\n            result['trends'].append({\n                'column': metric, 'period': 'MoM',\n                'direction': direction, 'pct_change': pct, 'segment': None\n            })\n    for seg_val in df['segment'].dropna().unique():\n        sub = df[df['segment'] == seg_val]\n        for metric in ['revenue', 'discount']:\n            monthly = sub.groupby('_ym')[metric].mean().sort_index()\n            if len(monthly) >= 2:\n                vals = monthly.values\n                last, prev = float(vals[-1]), float(vals[-2])\n                pct = round((last - prev) / prev * 100, 4) if prev != 0 else 0.0\n                direction = 'up' if pct > 0.5 else ('down' if pct < -0.5 else 'flat')\n                result['trends'].append({\n                    'column': metric, 'period': 'MoM',\n                    'direction': direction, 'pct_change': pct, 'segment': str(seg_val)\n                })\nexcept Exception as e:\n    result['assumptions'].append(f\"Trend partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    anomaly_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    total_flagged = 0\n    for col in anomaly_cols:\n        if total_flagged >= 25:\n            break\n        s = df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        if abs(skew) > 2:\n            shift = max(0, -s.min() + 1)\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n            shift = 0\n        Q1, Q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        IQR = Q3 - Q1\n        lo3, hi3 = Q1 - 3 * IQR, Q3 + 3 * IQR\n        lo4, hi4 = Q1 - 4 * IQR, Q3 + 4 * IQR\n        lo5, hi5 = Q1 - 5 * IQR, Q3 + 5 * IQR\n        mask = (s_t < lo3) | (s_t > hi3)\n        frac = mask.sum() / len(s_t)\n        if frac > 0.05:\n            result['anomalies'].append({\n                'column': col, 'row_index': None, 'value': None,\n                'expected_range': f'[{float(np.expm1(lo3) - shift):.2f}, {float(np.expm1(hi3) - shift):.2f}]',\n                'severity': 'low',\n                'explanation': f'{col} is heavy-tailed; extreme-value flagging skipped'\n            })\n            continue\n        flagged_idx = s_t[mask].index\n        orig_lo = float(np.expm1(lo3) - shift) if abs(skew) > 2 else float(lo3)\n        orig_hi = float(np.expm1(hi3) - shift) if abs(skew) > 2 else float(hi3)\n        exp_range = f'[{orig_lo:.4f}, {orig_hi:.4f}]'\n        for idx in flagged_idx:\n            if total_flagged >= 25:\n                break\n            val = float(df.loc[idx, col])\n            t_val = float(s_t.loc[idx])\n            if t_val > hi5 or t_val < lo5:\n                sev = 'critical'\n            elif t_val > hi4 or t_val < lo4:\n                sev = 'high'\n            else:\n                sev = 'medium'\n            result['anomalies'].append({\n                'column': col, 'row_index': int(idx), 'value': val,\n                'expected_range': exp_range, 'severity': sev,\n                'explanation': f'{col} value {val:.4f} lies outside expected range {exp_range}'\n            })\n            total_flagged += 1\nexcept Exception as e:\n    result['assumptions'].append(f\"Anomaly partial failure: {e}\")\n\ntry:\n    from scipy import stats\n    segs = df['segment'].dropna().unique()\n    groups_rev = [df[df['segment'] == s]['revenue'].dropna().values for s in segs]\n    if len(groups_rev) == 2:\n        stat, p = stats.ttest_ind(*groups_rev, equal_var=False)\n        stat, p = float(stat), float(p)\n        interp = f\"Welch t-test revenue by segment: t={stat:.3f}, p={p:.3g}; \" + (\n            \"significant difference\" if p < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'Welch t-test: revenue by segment',\n            'statistic': stat, 'p_value': p, 'interpretation': interp\n        })\n    elif len(groups_rev) > 2:\n        stat, p = stats.f_oneway(*groups_rev)\n        stat, p = float(stat), float(p)\n        interp = f\"One-way ANOVA revenue by segment: F={stat:.3f}, p={p:.3g}; \" + (\n            \"significant difference\" if p < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'One-way ANOVA: revenue by segment',\n            'statistic': stat, 'p_value': p, 'interpretation': interp\n        })\n    groups_disc = [df[df['segment'] == s]['discount'].dropna().values for s in segs]\n    if len(groups_disc) >= 2:\n        stat2, p2 = stats.kruskal(*groups_disc)\n        stat2, p2 = float(stat2), float(p2)\n        interp2 = f\"Kruskal-Wallis discount by segment: H={stat2:.3f}, p={p2:.3g}; \" + (\n            \"significant difference\" if p2 < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'Kruskal-Wallis: discount by segment',\n            'statistic': stat2, 'p_value': p2, 'interpretation': interp2\n        })\n    regions = df['region'].dropna().unique()\n    groups_rev_r = [df[df['region'] == r]['revenue'].dropna().values for r in regions]\n    if len(groups_rev_r) >= 2:\n        stat3, p3 = stats.f_oneway(*groups_rev_r)\n        stat3, p3 = float(stat3), float(p3)\n        interp3 = f\"One-way ANOVA revenue by region: F={stat3:.3f}, p={p3:.3g}; \" + (\n            \"significant difference\" if p3 < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'One-way ANOVA: revenue by region',\n            'statistic': stat3, 'p_value': p3, 'interpretation': interp3\n        })\n    r_corr, p_corr = stats.pearsonr(df['revenue'].dropna(), df['marketing_spend'].loc[df['revenue'].dropna().index])\n    r_corr, p_corr = float(r_corr), float(p_corr)\n    interp4 = f\"Pearson r revenue~marketing_spend: r={r_corr:.3f}, p={p_corr:.3g}; \" + (\n        \"significant linear association\" if p_corr < 0.05 else \"no significant relationship\")\n    result['statistical_tests'].append({\n        'test_name': 'Pearson correlation: revenue ~ marketing_spend',\n        'statistic': r_corr, 'p_value': p_corr, 'interpretation': interp4\n    })\nexcept Exception as e:\n    result['assumptions'].append(f\"Hypothesis partial failure: {e}\")\n\nresult['assumptions'].append(\"Discount is a rate (0-1); MoM uses mean not sum for discount.\")\nresult['assumptions'].append(\"Anomaly detection uses log1p transform for skewed columns (|skew|>2).\")\nresult['assumptions'].append(\"Correlations reported only for |r|>=0.2.\")", "result_excerpt": "{\"segment_column\": \"segment\", \"metric_column\": \"revenue\", \"aggregation\": \"mean\", \"results\": [{\"name\": \"A\", \"value\": 121.3297}, {\"name\": \"B\", \"value\": 98.1229}, {\"name\": \"C\", \"value\": 78.8821}]}", "row_count": 3025, "confidence": "high", "confidence_reason": "3025 rows", "assumptions": ["Discount is a rate (0-1); MoM uses mean not sum for discount.", "Anomaly detection uses log1p transform for skewed columns (|skew|>2).", "Correlations reported only for |r|>=0.2."]}, {"id": "seg:segment/discount", "kind": "segment", "claim": "mean discount by segment (3 groups)", "code": "try:\n    num_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    for col in num_cols:\n        s = df[col].dropna()\n        result['eda_summary'][col] = {\n            'mean': float(s.mean()), 'std': float(s.std()),\n            'min': float(s.min()), 'max': float(s.max()),\n            'median': float(s.median()), 'count': int(s.count())\n        }\nexcept Exception as e:\n    result['assumptions'].append(f\"EDA partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    pairs = [(a, b) for i, a in enumerate(num_cols) for b in num_cols[i+1:]]\n    for a, b in pairs:\n        sub = df[[a, b]].dropna()\n        if len(sub) < 10:\n            continue\n        r, _ = stats.pearsonr(sub[a], sub[b])\n        if abs(r) >= 0.2:\n            result['correlations'][f'{a}__{b}'] = round(float(r), 4)\nexcept Exception as e:\n    result['assumptions'].append(f\"Correlation partial failure: {e}\")\n\ntry:\n    seg_cols = ['segment', 'region']\n    target_metrics = ['revenue', 'discount']\n    for seg in seg_cols:\n        for metric in target_metrics:\n            grp = df.groupby(seg)[metric].mean().nlargest(10)\n            result['segments'].append({\n                'segment_column': seg,\n                'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': str(k), 'value': round(float(v), 4)} for k, v in grp.items()]\n            })\n        cnt = df.groupby(seg)[seg].count().nlargest(10)\n        result['segments'].append({\n            'segment_column': seg,\n            'metric_column': seg,\n            'aggregation': 'count',\n            'results': [{'name': str(k), 'value': int(v)} for k, v in cnt.items()]\n        })\n    if len(seg_cols) >= 2:\n        for metric in target_metrics:\n            grp2 = df.groupby(seg_cols)[metric].mean()\n            top10 = grp2.nlargest(10)\n            result['segments'].append({\n                'segment_column': f'{seg_cols[0]}|{seg_cols[1]}',\n                'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': f'{k[0]}|{k[1]}', 'value': round(float(v), 4)} for k, v in top10.items()]\n            })\nexcept Exception as e:\n    result['assumptions'].append(f\"Segmentation partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    df['order_date'] = pd.to_datetime(df['order_date'])\n    df['_ym'] = df['order_date'].dt.to_period('M')\n    for metric in ['revenue', 'discount']:\n        monthly = df.groupby('_ym')[metric].mean().sort_index()\n        if len(monthly) >= 2:\n            periods = monthly.index\n            vals = monthly.values\n            last, prev = float(vals[-1]), float(vals[-2])\n            pct = round((last - prev) / prev * 100, 4) if prev != 0 else 0.0\n            direction = 'up' if pct > 0.5 else ('down' if pct < -0.5 else 'flat')\n            result['trends'].append({\n                'column': metric, 'period': 'MoM',\n                'direction': direction, 'pct_change': pct, 'segment': None\n            })\n    for seg_val in df['segment'].dropna().unique():\n        sub = df[df['segment'] == seg_val]\n        for metric in ['revenue', 'discount']:\n            monthly = sub.groupby('_ym')[metric].mean().sort_index()\n            if len(monthly) >= 2:\n                vals = monthly.values\n                last, prev = float(vals[-1]), float(vals[-2])\n                pct = round((last - prev) / prev * 100, 4) if prev != 0 else 0.0\n                direction = 'up' if pct > 0.5 else ('down' if pct < -0.5 else 'flat')\n                result['trends'].append({\n                    'column': metric, 'period': 'MoM',\n                    'direction': direction, 'pct_change': pct, 'segment': str(seg_val)\n                })\nexcept Exception as e:\n    result['assumptions'].append(f\"Trend partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    anomaly_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    total_flagged = 0\n    for col in anomaly_cols:\n        if total_flagged >= 25:\n            break\n        s = df[col].dropna()\n        if s.nunique() < 5:\n            continue\n        skew = float(s.skew())\n        if abs(skew) > 2:\n            shift = max(0, -s.min() + 1)\n            s_t = np.log1p(s + shift)\n        else:\n            s_t = s.copy()\n            shift = 0\n        Q1, Q3 = s_t.quantile(0.25), s_t.quantile(0.75)\n        IQR = Q3 - Q1\n        lo3, hi3 = Q1 - 3 * IQR, Q3 + 3 * IQR\n        lo4, hi4 = Q1 - 4 * IQR, Q3 + 4 * IQR\n        lo5, hi5 = Q1 - 5 * IQR, Q3 + 5 * IQR\n        mask = (s_t < lo3) | (s_t > hi3)\n        frac = mask.sum() / len(s_t)\n        if frac > 0.05:\n            result['anomalies'].append({\n                'column': col, 'row_index': None, 'value': None,\n                'expected_range': f'[{float(np.expm1(lo3) - shift):.2f}, {float(np.expm1(hi3) - shift):.2f}]',\n                'severity': 'low',\n                'explanation': f'{col} is heavy-tailed; extreme-value flagging skipped'\n            })\n            continue\n        flagged_idx = s_t[mask].index\n        orig_lo = float(np.expm1(lo3) - shift) if abs(skew) > 2 else float(lo3)\n        orig_hi = float(np.expm1(hi3) - shift) if abs(skew) > 2 else float(hi3)\n        exp_range = f'[{orig_lo:.4f}, {orig_hi:.4f}]'\n        for idx in flagged_idx:\n            if total_flagged >= 25:\n                break\n            val = float(df.loc[idx, col])\n            t_val = float(s_t.loc[idx])\n            if t_val > hi5 or t_val < lo5:\n                sev = 'critical'\n            elif t_val > hi4 or t_val < lo4:\n                sev = 'high'\n            else:\n                sev = 'medium'\n            result['anomalies'].append({\n                'column': col, 'row_index': int(idx), 'value': val,\n                'expected_range': exp_range, 'severity': sev,\n                'explanation': f'{col} value {val:.4f} lies outside expected range {exp_range}'\n            })\n            total_flagged += 1\nexcept Exception as e:\n    result['assumptions'].append(f\"Anomaly partial failure: {e}\")\n\ntry:\n    from scipy import stats\n    segs = df['segment'].dropna().unique()\n    groups_rev = [df[df['segment'] == s]['revenue'].dropna().values for s in segs]\n    if len(groups_rev) == 2:\n        stat, p = stats.ttest_ind(*groups_rev, equal_var=False)\n        stat, p = float(stat), float(p)\n        interp = f\"Welch t-test revenue by segment: t={stat:.3f}, p={p:.3g}; \" + (\n            \"significant difference\" if p < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'Welch t-test: revenue by segment',\n            'statistic': stat, 'p_value': p, 'interpretation': interp\n        })\n    elif len(groups_rev) > 2:\n        stat, p = stats.f_oneway(*groups_rev)\n        stat, p = float(stat), float(p)\n        interp = f\"One-way ANOVA revenue by segment: F={stat:.3f}, p={p:.3g}; \" + (\n            \"significant difference\" if p < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'One-way ANOVA: revenue by segment',\n            'statistic': stat, 'p_value': p, 'interpretation': interp\n        })\n    groups_disc = [df[df['segment'] == s]['discount'].dropna().values for s in segs]\n    if len(groups_disc) >= 2:\n        stat2, p2 = stats.kruskal(*groups_disc)\n        stat2, p2 = float(stat2), float(p2)\n        interp2 = f\"Kruskal-Wallis discount by segment: H={stat2:.3f}, p={p2:.3g}; \" + (\n            \"significant difference\" if p2 < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'Kruskal-Wallis: discount by segment',\n            'statistic': stat2, 'p_value': p2, 'interpretation': interp2\n        })\n    regions = df['region'].dropna().unique()\n    groups_rev_r = [df[df['region'] == r]['revenue'].dropna().values for r in regions]\n    if len(groups_rev_r) >= 2:\n        stat3, p3 = stats.f_oneway(*groups_rev_r)\n        stat3, p3 = float(stat3), float(p3)\n        interp3 = f\"One-way ANOVA revenue by region: F={stat3:.3f}, p={p3:.3g}; \" + (\n            \"significant difference\" if p3 < 0.05 else \"no significant difference\")\n        result['statistical_tests'].append({\n            'test_name': 'One-way ANOVA: revenue by region',\n            'statistic': stat3, 'p_value': p3, 'interpretation': interp3\n        })\n    r_corr, p_corr = stats.pearsonr(df['revenue'].dropna(), df['marketing_spend'].loc[df['revenue'].dropna().index])\n    r_corr, p_corr = float(r_corr), float(p_corr)\n    interp4 = f\"Pearson r revenue~marketing_spend: r={r_corr:.3f}, p={p_corr:.3g}; \" + (\n        \"significant linear association\" if p_corr < 0.05 else \"no significant relationship\")\n    result['statistical_tests'].append({\n        'test_name': 'Pearson correlation: revenue ~ marketing_spend',\n        'statistic': r_corr, 'p_value': p_corr, 'interpretation': interp4\n    })\nexcept Exception as e:\n    result['assumptions'].append(f\"Hypothesis partial failure: {e}\")\n\nresult['assumptions'].append(\"Discount is a rate (0-1); MoM uses mean not sum for discount.\")\nresult['assumptions'].append(\"Anomaly detection uses log1p transform for skewed columns (|skew|>2).\")\nresult['assumptions'].append(\"Correlations reported only for |r|>=0.2.\")", "result_excerpt": "{\"segment_column\": \"segment\", \"metric_column\": \"discount\", \"aggregation\": \"mean\", \"results\": [{\"name\": \"C\", \"value\": 0.1515}, {\"name\": \"B\", \"value\": 0.1481}, {\"name\": \"A\", \"value\": 0.145}]}", "row_count": 3025, "confidence": "high", "confidence_reason": "3025 rows", "assumptions": ["Discount is a rate (0-1); MoM uses mean not sum for discount.", "Anomaly detection uses log1p transform for skewed columns (|skew|>2).", "Correlations reported only for |r|>=0.2."]}, {"id": "seg:segment/segment", "kind": "segment", "claim": "count segment by segment (3 groups)", "code": "try:\n    num_cols = ['revenue', 'units', 'discount', 'marketing_spend']\n    for col in num_cols:\n        s = df[col].dropna()\n        result['eda_summary'][col] = {\n            'mean': float(s.mean()), 'std': float(s.std()),\n            'min': float(s.min()), 'max': float(s.max()),\n            'median': float(s.median()), 'count': int(s.count())\n        }\nexcept Exception as e:\n    result['assumptions'].append(f\"EDA partial failure: {e}\")\n\ntry:\n    import numpy as np\n    from scipy import stats\n    pairs = [(a, b) for i, a in enumerate(num_cols) for b in num_cols[i+1:]]\n    for a, b in pairs:\n        sub = df[[a, b]].dropna()\n        if len(sub) < 10:\n            continue\n        r, _ = stats.pearsonr(sub[a], sub[b])\n        if abs(r) >= 0.2:\n            result['correlations'][f'{a}__{b}'] = round(float(r), 4)\nexcept Exception as e:\n    result['assumptions'].append(f\"Correlation partial failure: {e}\")\n\ntry:\n    seg_cols = ['segment', 'region']\n    target_metrics = ['revenue', 'discount']\n    for seg in seg_cols:\n        for metric in target_metrics:\n            grp = df.groupby(seg)[metric].mean().nlargest(10)\n            result['segments'].append({\n                'segment_column': seg,\n                'metric_column': metric,\n                'aggregation': 'mean',\n                'results': [{'name': str(k), 'value': round(float(v), 4)} for k, v in grp.items()]\n            })\n        cnt = df.groupby(seg)[seg].count().nlargest(10)\